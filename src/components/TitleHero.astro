---
interface Props {
  title: string;
  accent?: string;
  left: string;
  right: string;
}
const { title, accent, left, right } = Astro.props;
---
<header class="th wrap" data-th>
  <div class="th__labels">
    <p class="label muted">{left}</p>
    <p class="label muted">{right}</p>
  </div>
  <h1 class="th__title">
    <span class="th__word">{title}</span>
    {accent && <em class="th__accent">{accent}</em>}
  </h1>
</header>

<style>
  .th { padding-top: clamp(7rem, 14vh, 9rem); padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .th__labels { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--ink); }
  .th__title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2em 0.5em; margin-top: clamp(1rem, 2vw, 1.75rem); }
  .th__word {
    font-size: clamp(2.8rem, 8vw, 7.5rem);
    font-weight: 200;
    line-height: 0.9;
    letter-spacing: var(--tr-display);
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
  }
  .th__defs { position: absolute; width: 0; height: 0; }
  .th__accent {
    font-size: clamp(1rem, 2vw, 1.8rem);
    font-style: italic;
    font-weight: 300;
    letter-spacing: var(--tr-h2);
    text-transform: uppercase;
    color: var(--fg-muted);
    animation: th-in 0.6s var(--ease-out) 0.1s both;
  }
  @media (max-width: 600px) {
    .th { padding-top: 6rem; }
    .th__labels p:last-child { display: none; }
    .th__title { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  }
  @keyframes th-in { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .th__accent { animation: none; } }
</style>

