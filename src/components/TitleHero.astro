---
interface Props {
  title: string;
  accent?: string;
  left: string;
  right: string;
}
const { title, accent, left, right } = Astro.props;
const chars = [...title];
---
<section class="th" data-th>
  <div class="th__labels wrap">
    <p class="label muted">{left}</p>
    <p class="label muted">{right}</p>
  </div>

  <h1 class="th__title" aria-label={accent ? `${title}, ${accent}` : title}>
    <span class="th__word" aria-hidden="true">
      {chars.map((c, i) => <span class="th__mask"><span class="th__ch" style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span></span>)}
    </span>
    {accent && <span class="th__accent" aria-hidden="true" style={`--n:${chars.length}`}>{accent}</span>}
  </h1>

  <p class="th__hint label muted" aria-hidden="true"><span></span>Défiler</p>
</section>

<style>
  .th {
    --s: 0;
    position: relative;
    height: 88dvh;
    min-height: 520px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .th__labels { position: absolute; left: 0; right: 0; top: clamp(6.5rem, 13vh, 8.5rem); display: flex; justify-content: space-between; gap: 1rem; margin-inline: auto; }

  .th__title {
    display: grid;
    justify-items: center;
    padding-inline: var(--side);
    text-align: center;
    opacity: calc(1 - var(--s) * 1.1);
  }
  .th__word {
    display: flex;
    font-size: clamp(3.4rem, 14vw, 15rem);
    font-weight: 200;
    line-height: 0.9;
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
    white-space: nowrap;
    letter-spacing: calc(var(--tr-display) + var(--s) * 0.3em);
    animation: th-track 2s var(--ease-expo) backwards;
  }
  .th__mask { display: inline-block; overflow: hidden; padding: 0.08em 0 0.04em; margin: -0.08em 0 -0.04em; }
  .th__ch {
    display: inline-block;
    animation: th-ch 1.3s var(--ease-expo) backwards;
    animation-delay: calc(var(--i) * 60ms + 150ms);
  }
  .th__accent {
    margin-top: 0.6em;
    font-size: clamp(1.2rem, 3vw, 2.8rem);
    font-style: italic;
    font-weight: 300;
    letter-spacing: var(--tr-h1);
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
    animation: th-accent 1.4s var(--ease-expo) backwards;
    animation-delay: calc(var(--n) * 60ms + 450ms);
  }

  @keyframes th-ch {
    from { transform: translate3d(0, 105%, 0) rotate(6deg); filter: blur(8px); opacity: 0; }
  }
  @keyframes th-track {
    from { letter-spacing: 0.22em; }
  }
  @keyframes th-accent {
    from { clip-path: inset(0 100% 0 0); transform: translate3d(-0.4em, 0, 0); opacity: 0; }
    to { clip-path: inset(0 0 0 0); }
  }

  .th__hint { position: absolute; left: 50%; bottom: clamp(1.25rem, 4vh, 2.5rem); translate: -50% 0; display: grid; justify-items: center; gap: 0.6rem; opacity: calc(1 - var(--s) * 3); }
  .th__hint span { width: 1px; height: 36px; background: currentColor; transform-origin: top; animation: th-hint 2.4s var(--ease-in-out) infinite; }
  @keyframes th-hint { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  @media (prefers-reduced-motion: reduce) {
    .th__word, .th__ch, .th__accent, .th__hint span { animation: none; }
  }
</style>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-th]').forEach((root) => {
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = root.getBoundingClientRect();
        const s = Math.min(1, Math.max(0, -r.top / (r.height * 0.8)));
        root.style.setProperty('--s', s.toFixed(3));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    });
  }
</script>
