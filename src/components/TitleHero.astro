---
interface Props {
  title: string;
  accent?: string;
  left: string;
  right: string;
}
const { title, accent, left, right } = Astro.props;
const chars = [...title.toUpperCase()];
---
<section class="th" data-th>
  <div class="th__labels wrap">
    <p class="label muted">{left}</p>
    <p class="label muted">{right}</p>
  </div>

  <h1 class="th__title">
    <span class="sr-only">{accent ? `${title}, ${accent}` : title}</span>
    <svg class="th__svg" aria-hidden="true" focusable="false" data-th-svg>
      <text x="0" y="0" dominant-baseline="alphabetic">
        {chars.map((c, i) => <tspan style={`--i:${i}`}>{c === ' ' ? ' ' : c}</tspan>)}
      </text>
    </svg>
    {accent && <span class="th__accent" aria-hidden="true">{accent}</span>}
  </h1>

  <p class="th__hint label muted" aria-hidden="true"><span></span>Défiler</p>
</section>

<style>
  .th {
    --s: 0;
    --n: 8;
    position: relative;
    height: 100dvh;
    min-height: 520px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .th__labels { position: absolute; left: 0; right: 0; top: clamp(6.5rem, 13vh, 8.5rem); display: flex; justify-content: space-between; gap: 1rem; margin-inline: auto; }

  .th__title {
    display: grid;
    justify-items: center;
    padding-inline: var(--side);
    transform: translate3d(0, calc(var(--s) * -8vh), 0);
    opacity: calc(1 - var(--s) * 1.2);
  }
  .th__svg {
    display: block;
    height: clamp(3rem, 12.5vw, 13.5rem);
    max-width: calc(100vw - 2 * var(--side));
    overflow: visible;
    opacity: 0;
  }
  .th__svg text {
    font-family: var(--text);
    font-size: 100px;
    font-weight: 200;
    letter-spacing: -0.04em;
    font-feature-settings: 'case' 1;
    fill: currentColor;
    fill-opacity: 0;
    stroke: currentColor;
    stroke-width: 0.9px;
    stroke-linejoin: round;
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
  }
  .th.is-go .th__svg { opacity: 1; }
  .th.is-go .th__svg tspan {
    animation: th-draw 1.6s cubic-bezier(0.65, 0, 0.35, 1) forwards, th-fill 0.9s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 110ms), calc(var(--i) * 110ms + 1s);
  }
  @keyframes th-draw { to { stroke-dashoffset: 0; } }
  @keyframes th-fill { to { fill-opacity: 1; stroke-opacity: 0; } }

  .th__accent {
    margin-top: 0.7em;
    font-size: clamp(1.1rem, 2.6vw, 2.5rem);
    font-style: italic;
    font-weight: 300;
    letter-spacing: var(--tr-h1);
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
    clip-path: inset(0 100% 0 0);
  }
  .th.is-go .th__accent {
    animation: th-accent 1.2s var(--ease-expo) forwards;
    animation-delay: calc(var(--n) * 110ms + 1.1s);
  }
  @keyframes th-accent { to { clip-path: inset(0 0 0 0); } }

  .th__hint { position: absolute; left: 50%; bottom: clamp(1.25rem, 4vh, 2.5rem); translate: -50% 0; display: grid; justify-items: center; gap: 0.6rem; opacity: calc(1 - var(--s) * 3); }
  .th__hint span { width: 1px; height: 36px; background: currentColor; transform-origin: top; animation: th-hint 2.4s var(--ease-in-out) infinite; }
  @keyframes th-hint { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  @media (prefers-reduced-motion: reduce) {
    .th__svg { opacity: 1; }
    .th__svg text { fill-opacity: 1; stroke: none; }
    .th.is-go .th__svg tspan, .th.is-go .th__accent, .th__hint span { animation: none; }
    .th__accent { clip-path: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-th]').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('[data-th-svg]')!;
    const text = svg.querySelector('text')!;
    const n = text.querySelectorAll('tspan').length;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.style.setProperty('--n', String(n));

    const fit = () => {
      const b = text.getBBox();
      const pad = 2;
      svg.setAttribute('viewBox', `${(b.x - pad).toFixed(1)} ${(b.y - pad).toFixed(1)} ${(b.width + pad * 2).toFixed(1)} ${(b.height + pad * 2).toFixed(1)}`);
      svg.style.aspectRatio = `${b.width + pad * 2} / ${b.height + pad * 2}`;
    };

    const start = () => {
      fit();
      requestAnimationFrame(() => root.classList.add('is-go'));
      if (reduce || scrollY > 10) return;

      let cancelled = false;
      const cancel = () => { cancelled = true; };
      const opts = { passive: true, once: true } as const;
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((ev) => addEventListener(ev, cancel, opts));

      const wait = n * 110 + 2300;
      setTimeout(() => {
        if (cancelled || scrollY > 10) return;
        const target = root.getBoundingClientRect().bottom + scrollY;
        const from = scrollY, dist = target - from, t0 = performance.now(), dur = 1400;
        const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        const step = (t: number) => {
          if (cancelled) return;
          const p = Math.min(1, (t - t0) / dur);
          scrollTo(0, from + dist * ease(p));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }, wait);
    };
    document.fonts.ready.then(start);
    addEventListener('resize', fit);

    if (!reduce) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = root.getBoundingClientRect();
        root.style.setProperty('--s', Math.min(1, Math.max(0, -r.top / (r.height * 0.8))).toFixed(3));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }
  });
</script>
