<svg class="edges-svg" aria-hidden="true" focusable="false">
  <filter id="edge-warp" x="0" y="0" width="100%" height="100%">
    <feTurbulence type="fractalNoise" baseFrequency="0.006 0.035" numOctaves="2" seed="7" result="n" />
    <feDisplacementMap in="SourceGraphic" in2="n" scale="64" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<div class="edge edge--top" aria-hidden="true" data-edge="top">
  <i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="warp"></i><i class="fog"></i>
</div>
<div class="edge edge--bottom" aria-hidden="true" data-edge="bottom">
  <i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="warp"></i><i class="fog"></i>
</div>

<style>
  .edges-svg { position: absolute; width: 0; height: 0; }
  .edge {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 44;
    pointer-events: none;
    transition: transform 0.6s var(--ease-out);
  }
  .edge--top { top: 0; height: clamp(100px, 17vh, 200px); transform: translateY(calc((1 - var(--o, 0)) * -100%)); }
  .edge--bottom { bottom: 0; height: clamp(120px, 21vh, 240px); transform: translateY(calc((1 - var(--o, 0)) * 100%)); }
  .edge i { position: absolute; inset: 0; }
  .edge--top i { --dir: to top; }
  .edge--bottom i { --dir: to bottom; }
  .edge .b1 { -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); -webkit-mask: linear-gradient(var(--dir), transparent 0%, #000 35%); mask: linear-gradient(var(--dir), transparent 0%, #000 35%); }
  .edge .b2 { -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); -webkit-mask: linear-gradient(var(--dir), transparent 30%, #000 65%); mask: linear-gradient(var(--dir), transparent 30%, #000 65%); }
  .edge .b3 { -webkit-backdrop-filter: blur(26px); backdrop-filter: blur(26px); -webkit-mask: linear-gradient(var(--dir), transparent 62%, #000 100%); mask: linear-gradient(var(--dir), transparent 62%, #000 100%); }
  .edge .warp {
    display: none;
    backdrop-filter: url(#edge-warp);
    -webkit-mask: linear-gradient(var(--dir), transparent 0%, #000 55%);
    mask: linear-gradient(var(--dir), transparent 0%, #000 55%);
  }
  :global(.is-fast) .edge .warp { display: block; }
  .edge .fog { background: linear-gradient(var(--dir), rgba(236, 236, 235, 0) 45%, rgba(236, 236, 235, 0.55) 100%); }
  @media (prefers-reduced-motion: reduce) {
    .edge .warp { display: none; }
  }
  @media (max-width: 640px) {
    .edge--top { height: 90px; }
    .edge--bottom { height: 120px; }
    .edge .warp { display: none; }
  }
</style>

<script>
  const top = document.querySelector<HTMLElement>('[data-edge="top"]');
  const bottom = document.querySelector<HTMLElement>('[data-edge="bottom"]');
  if (top && bottom) {
    const set = () => {
      const y = scrollY;
      const max = document.documentElement.scrollHeight - innerHeight;
      top.style.setProperty('--o', y > 80 ? '1' : '0');
      bottom.style.setProperty('--o', y > 120 && max - y > 160 ? '1' : '0');
    };
    set();
    addEventListener('scroll', set, { passive: true });
    addEventListener('resize', set);
  }
</script>
