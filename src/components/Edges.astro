<div class="edge edge--top" aria-hidden="true" data-edge="top">
  <i class="b1"></i><i class="b2"></i>
</div>
<div class="edge edge--bottom" aria-hidden="true" data-edge="bottom">
  <i class="b1"></i><i class="b2"></i>
</div>

<style>
  .edge {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 44;
    pointer-events: none;
    transition: transform 0.6s var(--ease-out);
  }
  .edge--top { top: 0; height: clamp(48px, 7vh, 80px); transform: translateY(calc((1 - var(--o, 0)) * -100%)); }
  .edge--bottom { bottom: 0; height: clamp(56px, 8vh, 96px); transform: translateY(calc((1 - var(--o, 0)) * 100%)); }
  .edge i { position: absolute; inset: 0; }
  .edge--top i { --dir: to top; }
  .edge--bottom i { --dir: to bottom; }
  .edge .b1 { -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); -webkit-mask: linear-gradient(var(--dir), transparent 0%, #000 50%); mask: linear-gradient(var(--dir), transparent 0%, #000 50%); }
  .edge .b2 { -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); -webkit-mask: linear-gradient(var(--dir), transparent 50%, #000 100%); mask: linear-gradient(var(--dir), transparent 50%, #000 100%); }
</style>

<script>
  const top = document.querySelector<HTMLElement>('[data-edge="top"]');
  const bottom = document.querySelector<HTMLElement>('[data-edge="bottom"]');
  if (top && bottom) {
    const set = () => {
      const y = scrollY;
      const max = document.documentElement.scrollHeight - innerHeight;
      top.style.setProperty('--o', y > 80 ? '1' : '0');
      bottom.style.setProperty('--o', y > 120 && max - y > 160 ? '1' : '0');
    };
    set();
    addEventListener('scroll', set, { passive: true });
    addEventListener('resize', set);
  }
</script>
