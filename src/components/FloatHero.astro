---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  src: ImageMetadata;
  x?: number;
  y?: number;
  w?: number;
  r?: number;
  d?: number;
  ratio?: string;
  pos?: string;
  label?: string;
  value?: number;
}
interface Props {
  title: string;
  accent?: string;
  left: string;
  right: string;
  photos: Photo[];
  variant?: 'float' | 'deck' | 'orbit' | 'wall' | 'breath' | 'window' | 'bars' | 'days';
  cols?: string[];
}
const { title, accent, left, right, photos, variant = 'float', cols = [] } = Astro.props;
const shots = await Promise.all(photos.map((p) => getImage({ src: p.src, width: variant === 'window' ? 1600 : 640, format: 'webp' })));
const max = Math.max(...photos.map((p) => p.value || 0), 1);
---
<section class:list={['fh', `fh--${variant}`]} data-fh data-variant={variant}>
  <div class="fh__labels wrap">
    <p class="label muted">{left}</p>
    <p class="label muted">{right}</p>
  </div>

  {variant === 'window' ? (
    <div class="fh__win" aria-hidden="true">
      <img class="fh__bg" src={shots[0].src} alt="" style={`object-position:${photos[0].pos ?? '50% 50%'}`} />
      <div class="fh__lens" data-lens><img src={shots[0].src} alt="" style={`object-position:${photos[0].pos ?? '50% 50%'}`} /></div>
    </div>
  ) : (
    <div class="fh__stage" aria-hidden="true">
      {variant === 'days' && cols.map((c, i) => <span class="fh__col" style={`--c:${i}; --n:${cols.length}`}><em>{c}</em></span>)}
      {photos.map((p, i) => (
        <span
          class:list={['fh__p', (p.d ?? 0.5) > 0.7 ? 'is-front' : 'is-back']}
          style={`--x:${p.x ?? 50}%; --y:${p.y ?? 50}%; --w:${p.w ?? 14}vw; --r:${p.r ?? 0}deg; --i:${i}; --n:${photos.length}; --h:${((p.value || 0) / max).toFixed(3)}; aspect-ratio:${p.ratio ?? '4/5'}`}
          data-depth={p.d ?? 0.5}
          data-r={p.r ?? 0}
        >
          <span class="fh__pin"><img src={shots[i].src} alt="" style={`object-position:${p.pos ?? '50% 50%'}`} loading="eager" draggable="false" /></span>
          {p.label && <span class="fh__cap"><b>{p.value} €</b>{p.label}</span>}
        </span>
      ))}
    </div>
  )}

  <div class="fh__center">
    {Astro.slots.has('default') ? <slot /> : (
      <h1 class="fh__title" data-fh-title>
        <span>{title}</span>
        {accent && <em>{accent}</em>}
      </h1>
    )}
  </div>

  <p class="fh__hint label muted" aria-hidden="true"><span></span>Défiler</p>
</section>

<style>
  .fh { position: relative; height: 100dvh; min-height: 600px; overflow: hidden; }
  .fh__labels { position: absolute; left: 0; right: 0; top: clamp(6.5rem, 13vh, 8.5rem); z-index: 6; display: flex; justify-content: space-between; gap: 1rem; margin-inline: auto; pointer-events: none; }
  .fh__stage { position: absolute; inset: 0; z-index: 1; }
  .fh__p {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: clamp(90px, var(--w), 300px);
    translate: -50% -50%;
    opacity: 0;
    scale: 0.7;
    transition: opacity 1.1s var(--ease-out), scale 1.5s var(--ease-expo);
    transition-delay: calc(var(--i) * 80ms + 250ms);
  }
  .fh.is-in .fh__p { opacity: 1; scale: 1; }
  .fh.is-in .fh__p.is-back { opacity: 0.82; }
  .fh__p.is-front { z-index: 3; }
  .fh__pin {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 4px;
    rotate: var(--r);
    box-shadow: 0 30px 50px -30px rgba(20, 22, 23, 0.45);
    will-change: transform;
    transition: scale 0.6s var(--ease-expo), rotate 0.6s var(--ease-expo), filter 0.45s var(--ease-out);
  }
  .fh__p.is-back .fh__pin { filter: blur(2.5px) saturate(0.85); }
  .fh__pin img { width: 100%; height: 100%; object-fit: cover; }

  .fh__center { position: absolute; left: 50%; top: 50%; z-index: 4; width: max-content; max-width: 100%; translate: -50% -50%; display: grid; place-items: center; padding-inline: var(--side); pointer-events: none; }
  .fh__title {
    display: grid;
    justify-items: center;
    text-align: center;
    font-size: clamp(3.2rem, 12.5vw, 13.5rem);
    font-weight: 200;
    line-height: 0.86;
    letter-spacing: var(--tr-display);
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
    animation: fh-in 1.6s var(--ease-expo) 0.15s backwards;
  }
  .fh__title em { font-style: italic; font-weight: 300; font-size: 0.42em; letter-spacing: var(--tr-h1); margin-top: 0.25em; }
  @keyframes fh-in { from { opacity: 0; filter: blur(16px); transform: translateY(24px); } }
  .fh--bars .fh__center { top: 30%; }
  .fh--days .fh__center { top: 27%; }
  .fh--deck .fh__center { top: 27%; }
  .fh--orbit .fh__title, .fh--deck .fh__title, .fh--days .fh__title, .fh--bars .fh__title { font-size: clamp(3rem, 9.5vw, 10.5rem); }
  .fh--window .fh__center { left: var(--side); top: auto; bottom: clamp(5.5rem, 13vh, 8.5rem); translate: none; place-items: start; padding-inline: 0; }
  .fh--window .fh__title { justify-items: start; text-align: left; }

  .fh__hint { position: absolute; left: 50%; bottom: clamp(1.25rem, 4vh, 2.5rem); z-index: 6; translate: -50% 0; display: grid; justify-items: center; gap: 0.6rem; }
  .fh__hint span { width: 1px; height: 36px; background: currentColor; transform-origin: top; animation: hint 2.4s var(--ease-in-out) infinite; }
  @keyframes hint { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  .fh--deck .fh__p { left: 50%; top: 68%; }
  .fh--orbit .fh__p { left: 50%; top: 50%; }
  .fh--deck .fh__p { width: clamp(150px, 17vw, 270px); }
  .fh--deck .fh__p.is-back .fh__pin, .fh--orbit .fh__p.is-back .fh__pin { filter: none; }
  .fh--orbit .fh__p { width: clamp(100px, 13vw, 220px); }
  .fh--orbit .fh__p.is-far .fh__pin { filter: blur(2.5px) saturate(0.85); }

  .fh--wall .fh__pin { transform-origin: 50% -10px; overflow: visible; }
  .fh--wall .fh__pin img { border-radius: 2px; }
  .fh--wall .fh__pin::before { content: ''; position: absolute; left: 50%; top: -10px; width: 46px; height: 18px; translate: -50% 0; rotate: -3deg; background: color-mix(in srgb, var(--paper) 70%, transparent); box-shadow: 0 1px 2px rgba(20, 22, 23, 0.15); z-index: 1; }

  .fh--bars .fh__p {
    top: auto;
    bottom: 0;
    left: calc(var(--side) + (100% - 2 * var(--side)) * (var(--i) + 0.5) / var(--n));
    width: calc((100% - 2 * var(--side)) / var(--n) - clamp(8px, 1.4vw, 20px));
    height: calc(9vh + var(--h) * 34vh);
    aspect-ratio: auto !important;
    translate: -50% 0;
    scale: 1 0;
    transform-origin: 50% 100%;
    transition: opacity 0.8s var(--ease-out), scale 1.6s var(--ease-expo);
  }
  .fh--bars.is-in .fh__p { scale: 1 1; }
  .fh--bars .fh__pin { border-radius: 4px 4px 0 0; box-shadow: none; filter: none !important; }
  .fh--bars .fh__p.is-back .fh__pin { filter: none; }
  .fh__cap { position: absolute; left: 0; right: 0; bottom: calc(100% + 0.6rem); display: grid; gap: 2px; font-size: 11px; letter-spacing: var(--tr-caps); text-transform: uppercase; color: var(--fg-muted); }
  .fh__cap b { font-weight: 300; font-size: clamp(1.1rem, 1.8vw, 1.6rem); letter-spacing: var(--tr-h2); color: var(--fg); font-variant-numeric: tabular-nums; }

  .fh--days .fh__col {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--side) + (100% - 2 * var(--side)) * var(--c) / var(--n));
    width: calc((100% - 2 * var(--side)) / var(--n));
    border-left: 1px solid var(--line);
    transition: background-color 0.5s var(--ease-out);
  }
  .fh--days .fh__col:last-of-type { border-right: 1px solid var(--line); }
  .fh--days .fh__col em { position: absolute; left: 10px; bottom: clamp(5rem, 12vh, 7rem); font-style: normal; font-size: 12px; letter-spacing: var(--tr-caps); text-transform: uppercase; color: var(--fg-muted); }
  .fh--days .fh__col.is-hot { background: color-mix(in srgb, var(--fg) 4%, transparent); }
  .fh--days .fh__col.is-hot em { color: var(--fg); }
  .fh--days .fh__p { left: calc(var(--side) + (100% - 2 * var(--side)) * (var(--i) + 0.5) / var(--n)); width: clamp(90px, calc((100vw - 2 * var(--side)) / var(--n) - 40px), 230px); }
  .fh--days .fh__p .fh__pin { filter: blur(3px) saturate(0.8); }
  .fh--days .fh__p.is-hot .fh__pin { filter: none; scale: 1.08; }

  .fh__win { position: absolute; inset: 0; z-index: 1; }
  .fh__bg { position: absolute; inset: -4%; width: 108%; height: 108%; object-fit: cover; filter: blur(22px) saturate(0.5); opacity: 0.22; }
  .fh__lens {
    position: absolute;
    inset: 0;
    clip-path: inset(var(--t, 30%) var(--r, 33%) var(--b, 30%) var(--l, 33%) round 4px);
    transition: clip-path 0.15s linear;
  }
  .fh__lens img { width: 100%; height: 100%; object-fit: cover; }

  @media (hover: hover) and (pointer: fine) {
    .fh__stage { pointer-events: auto; }
    .fh.is-ready .fh__p { transition-delay: 0s; }
    .fh--float.is-ready .fh__p:hover, .fh--wall.is-ready .fh__p:hover { opacity: 1; z-index: 5; }
    :is(.fh--float, .fh--wall, .fh--breath) .fh__p:hover .fh__pin { scale: 1.12; filter: none; }
  }
  @media (max-width: 760px) {
    .fh__p { width: clamp(64px, calc(var(--w) * 1.6), 140px); }
    .fh--deck .fh__p { width: 42vw; }
    .fh--orbit .fh__p { width: 28vw; }
    .fh__cap { display: none; }
    .fh--days .fh__col em { bottom: 4.5rem; left: 4px; font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fh__title, .fh__hint span { animation: none; }
    .fh__p { transition: none; opacity: 1; scale: 1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-fh]').forEach((root) => {
    const v = root.dataset.variant || 'float';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const title = root.querySelector<HTMLElement>('[data-fh-title]');
    const lens = root.querySelector<HTMLElement>('[data-lens]');
    const cols = [...root.querySelectorAll<HTMLElement>('.fh__col')];
    const els = [...root.querySelectorAll<HTMLElement>('.fh__p')];
    const items = els.map((el, i) => ({ el, pin: el.querySelector<HTMLElement>('.fh__pin')!, d: Number(el.dataset.depth), r: Number(el.dataset.r), ph: i * 1.9, sw: 0 }));
    const n = items.length;
    requestAnimationFrame(() => root.classList.add('is-in'));
    setTimeout(() => root.classList.add('is-ready'), 2000);

    let mx = 0, my = 0, cmx = 0, cmy = 0, pmx = 0, visible = true, inside = false, hot = -1;
    let lx = 0.5, ly = 0.5;
    if (fine) {
      root.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        mx = (e.clientX - r.left) / r.width - 0.5;
        my = (e.clientY - r.top) / r.height - 0.5;
        inside = true;
      }, { passive: true });
      root.addEventListener('pointerleave', () => { mx = 0; my = 0; inside = false; });
    }
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);
    if (reduce) {
      if (lens) { lens.style.setProperty('--t', '25%'); lens.style.setProperty('--b', '25%'); lens.style.setProperty('--l', '30%'); lens.style.setProperty('--r', '30%'); }
      return;
    }

    const breath = (t: number) => {
      const c = (t % 10) / 10;
      if (c < 0.4) return 0.5 - 0.5 * Math.cos((c / 0.4) * Math.PI);
      if (c < 0.48) return 1;
      return 0.5 + 0.5 * Math.cos(((c - 0.48) / 0.52) * Math.PI);
    };

    const tick = (time: number) => {
      if (visible) {
        const t = time / 1000;
        if (!fine || !inside) {
          const ax = Math.sin(t * 0.33) * (fine ? 0 : 0.28), ay = Math.cos(t * 0.27) * (fine ? 0 : 0.2);
          if (!fine) { mx = ax; my = ay; }
        }
        pmx = cmx;
        cmx += (mx - cmx) * 0.06;
        cmy += (my - cmy) * 0.06;
        const vel = cmx - pmx;
        const r = root.getBoundingClientRect();
        const scroll = Math.max(0, -r.top);
        if (title) title.style.transform = `translate3d(${(-cmx * 16).toFixed(1)}px, ${(-cmy * 12 + scroll * 0.25).toFixed(1)}px, 0)`;

        if (v === 'window' && lens) {
          const tx = fine && inside ? mx + 0.5 : 0.5 + Math.sin(t * 0.4) * 0.22;
          const ty = fine && inside ? my + 0.5 : 0.5 + Math.cos(t * 0.33) * 0.12;
          lx += (tx - lx) * 0.08;
          ly += (ty - ly) * 0.08;
          const w = 0.34, h = 0.38;
          const L = Math.max(0.02, Math.min(0.98 - w, lx - w / 2)), T = Math.max(0.15, Math.min(0.22, ly - h / 2));
          lens.style.setProperty('--l', `${(L * 100).toFixed(2)}%`);
          lens.style.setProperty('--r', `${((1 - L - w) * 100).toFixed(2)}%`);
          lens.style.setProperty('--t', `${(T * 100).toFixed(2)}%`);
          lens.style.setProperty('--b', `${((1 - T - h) * 100).toFixed(2)}%`);
        }

        if (v === 'days' && cols.length) {
          const idx = fine && inside ? Math.floor((mx + 0.5) * cols.length) : Math.floor(((t * 0.18) % 1) * cols.length);
          if (idx !== hot) {
            hot = idx;
            cols.forEach((c, i) => c.classList.toggle('is-hot', i === idx));
            items.forEach((it, i) => it.el.classList.toggle('is-hot', i === idx));
          }
        }

        const b = breath(t);
        items.forEach((it, i) => {
          const { pin, d, ph } = it;
          const fx = Math.sin(t * 0.5 + ph) * 9;
          const fy = Math.cos(t * 0.6 + ph) * 11;
          if (v === 'deck') {
            const k = i - (n - 1) / 2;
            const spread = 0.35 + Math.min(1, Math.abs(cmx) * 2.4) * 0.65 + Math.min(1, scroll / 400) * 0.4;
            const x = k * (34 + spread * 150) + cmx * 40;
            const y = Math.abs(k) * (6 + spread * 18) - scroll * 0.2 + fy * 0.4;
            const rot = k * (3 + spread * 7) + cmx * 6;
            pin.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) rotate(${rot.toFixed(2)}deg)`;
            it.el.style.zIndex = String(10 - Math.round(Math.abs(k)));
          } else if (v === 'orbit') {
            const a = (i / n) * Math.PI * 2 + t * 0.14 + cmx * 0.9;
            const rx = Math.min(innerWidth * 0.42, 640), ry = Math.min(innerHeight * 0.32, 300);
            const z = Math.sin(a);
            const depth = (z + 1) / 2;
            const x = Math.cos(a) * rx;
            const y = z * ry + cmy * 40 - scroll * 0.3;
            pin.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${(0.6 + depth * 0.55).toFixed(3)})`;
            it.el.style.zIndex = '1';
            it.el.classList.toggle('is-far', depth < 0.35);
            it.el.style.opacity = String((0.45 + depth * 0.55).toFixed(2));
          } else if (v === 'wall') {
            it.sw += (vel * 900 * (0.6 + d) - it.sw) * 0.08;
            it.sw *= 0.96;
            const rot = it.r + Math.sin(t * 0.7 + ph) * 1.1 - it.sw;
            pin.style.transform = `translate3d(${(-cmx * d * 60).toFixed(1)}px, ${(-cmy * d * 40 - scroll * d * 0.4).toFixed(1)}px, 0) rotate(${rot.toFixed(2)}deg)`;
          } else if (v === 'bars') {
            const lift = Math.max(0, 1 - Math.abs(mx + 0.5 - (i + 0.5) / n) * n * 0.9) * (fine && inside ? 1 : 0);
            pin.style.transform = `translate3d(0, ${(-lift * 18 + scroll * (0.15 + d * 0.2)).toFixed(1)}px, 0)`;
          } else if (v === 'days') {
            const y = Math.sin(t * 0.45 + ph) * 14 - scroll * (0.2 + d * 0.3);
            pin.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0)`;
          } else {
            const ox = -cmx * d * 110;
            const oy = -cmy * d * 70 - scroll * d * 0.45;
            const s = v === 'breath' ? 0.9 + b * 0.16 * (0.6 + d) : 1;
            pin.style.transform = `perspective(700px) translate3d(${(fx + ox).toFixed(1)}px, ${(fy + oy).toFixed(1)}px, 0) rotateX(${(-cmy * 20 * d).toFixed(2)}deg) rotateY(${(cmx * 26 * d).toFixed(2)}deg) scale(${s.toFixed(3)})`;
          }
        });
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
