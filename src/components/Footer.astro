---
import { navigation, site, tel, sms } from '../data/site';
const year = new Date().getFullYear();
const word = 'Daléas Danse';
---
<footer class="foot on-black">
  <div class="wrap foot__grid">
    <p class="foot__lead">Une question ?<br /><em>Un appel suffit.</em></p>

    <div class="foot__col foot__c1">
      <p class="label muted">Cours & stages</p>
      {site.teachers.map((t) => (
        <a href={tel(t.phone)} class="foot__tel"><span>{t.name}</span><span>{t.phone}</span></a>
      ))}
    </div>

    <div class="foot__col foot__c2">
      <p class="label muted">Adresse</p>
      <address>{site.address.venue}<br />{site.address.street}<br />{site.address.zip} {site.address.city}</address>
      <a href={site.mapsUrl} target="_blank" rel="noopener" class="foot__a">Itinéraire ↗</a>
    </div>

    <div class="foot__col foot__c3">
      <p class="label muted">Location</p>
      <a href={sms(site.rentalPhone)} class="foot__a">SMS {site.rentalPhone}</a>
      <a href={`mailto:${site.email}`} class="foot__a">{site.email}</a>
    </div>

    <nav class="foot__col foot__c4" aria-label="Pied de page">
      <p class="label muted">Pages</p>
      <ul>{navigation.map((n) => <li><a href={n.href} class="foot__a">{n.label}</a></li>)}</ul>
    </nav>

    <div class="foot__col foot__c5">
      <p class="label muted">Suivre</p>
      {site.socials.map((s) => <a href={s.href} target="_blank" rel="noopener" class="foot__a">{s.label} ↗</a>)}
    </div>
  </div>

  <p class="foot__word" aria-hidden="true" data-fit>
    {[...word].map((c, i) => <span class="foot__ch" style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>)}
  </p>

  <div class="wrap foot__bar label">
    <span>© {year}</span>
    <span>Annecy, depuis 1965</span>
    <a href="/mentions-legales/" class="foot__a">Mentions légales</a>
    <button class="foot__a foot__top" data-top>Haut de page ↑</button>
  </div>
</footer>

<style>
  .foot { padding: var(--section) 0 1.25rem; overflow: hidden; }

  .foot__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2.5rem, 5vw, 4rem);
  }
  .foot__lead {
    grid-column: 1 / span 7;
    font-size: clamp(2rem, 4.4vw, 4.2rem);
    font-weight: 200;
    line-height: 1.02;
    letter-spacing: var(--tr-h1);
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
  }
  .foot__lead em { font-style: italic; font-weight: 300; color: var(--fg-muted); }

  .foot__col { display: flex; flex-direction: column; align-items: flex-start; gap: 0.45rem; font-size: 14px; line-height: 1.55; }
  .foot__col .label { margin-bottom: 0.6rem; }
  .foot__col address { font-style: normal; }
  .foot__c1 { grid-column: 9 / span 4; align-self: end; }
  .foot__c2 { grid-column: 1 / span 3; }
  .foot__c3 { grid-column: 4 / span 3; }
  .foot__c4 { grid-column: 7 / span 3; }
  .foot__c4 ul { columns: 2; column-gap: 1.5rem; }
  .foot__c4 li { break-inside: avoid; margin-bottom: 0.45rem; }
  .foot__c5 { grid-column: 10 / span 3; }

  .foot__tel {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    font-weight: 300;
    letter-spacing: var(--tr-lead);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s var(--ease-out), padding 0.6s var(--ease-expo);
  }
  .foot__tel span:first-child { font-size: 12px; font-weight: 400; letter-spacing: var(--tr-caps); text-transform: uppercase; color: var(--fg-muted); }
  .foot__tel:hover { color: var(--plum); padding-left: 0.5rem; }
  .on-black .foot__tel:hover { color: var(--white); }

  .foot__a {
    color: var(--fg-muted);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color 0.3s var(--ease-out), background-size 0.5s var(--ease-expo);
  }
  .foot__a:hover { color: var(--fg); background-size: 100% 1px; }

  .foot__word {
    display: flex;
    justify-content: center;
    margin: clamp(4rem, 9vw, 7rem) 0 1rem;
    padding-inline: var(--side);
    font-size: 12vw;
    font-weight: 200;
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    font-feature-settings: 'case' 1;
    cursor: default;
    user-select: none;
  }
  .foot__ch {
    display: inline-block;
    font-variation-settings: 'wght' var(--w, 200);
    transform: translateY(var(--y, 0));
    transition: transform 1.1s var(--ease-expo);
  }
  .foot__word.is-wait .foot__ch { --y: 0.9em; transition: none; }
  .foot__word.is-in .foot__ch { transition-delay: calc(var(--i) * 45ms); }

  .foot__bar {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--fg-muted);
  }
  .foot__top { text-transform: uppercase; letter-spacing: inherit; font-size: inherit; justify-self: end; }

  @media (max-width: 1000px) {
    .foot__lead { grid-column: 1 / -1; }
    .foot__c1 { grid-column: 1 / -1; }
    .foot__c2 { grid-column: 1 / span 6; }
    .foot__c3 { grid-column: 7 / span 6; }
    .foot__c4 { grid-column: 1 / span 6; }
    .foot__c5 { grid-column: 7 / span 6; }
  }
  @media (max-width: 560px) {
    .foot__c2, .foot__c3, .foot__c4, .foot__c5 { grid-column: 1 / -1; }
    .foot__bar { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .foot__word.is-wait .foot__ch { --y: 0; }
  }
</style>

<script>
  const word = document.querySelector<HTMLElement>('[data-fit]');
  document.querySelector('[data-top]')?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  if (word) {
    const chars = [...word.querySelectorAll<HTMLElement>('.foot__ch')];
    const fit = () => {
      word.style.fontSize = '100px';
      const pad = parseFloat(getComputedStyle(word).paddingLeft) * 2;
      const w = chars.reduce((n, c) => n + c.getBoundingClientRect().width, 0);
      word.style.fontSize = `${Math.floor(((word.clientWidth - pad) / w) * 100 * 10) / 10}px`;
    };
    document.fonts.ready.then(fit);
    addEventListener('resize', fit);

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      word.classList.add('is-wait');
      new IntersectionObserver(([e], o) => {
        if (!e.isIntersecting) return;
        word.classList.remove('is-wait');
        word.classList.add('is-in');
        o.disconnect();
      }, { threshold: 0.4 }).observe(word);

      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let mx = -1, raf = 0;
        const paint = () => {
          raf = 0;
          chars.forEach((c) => {
            const r = c.getBoundingClientRect();
            const d = mx < 0 ? 1 : Math.min(1, Math.abs(mx - (r.left + r.width / 2)) / (innerWidth * 0.14));
            c.style.setProperty('--w', String(Math.round(200 + (1 - d) * (1 - d) * 200)));
          });
        };
        word.addEventListener('pointermove', (e) => { mx = e.clientX; if (!raf) raf = requestAnimationFrame(paint); });
        word.addEventListener('pointerleave', () => { mx = -1; if (!raf) raf = requestAnimationFrame(paint); });
      }
    }
  }
</script>
