---
import { navigation, site, tel, sms } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="foot on-black">
  <div class="wrap">
    <div class="foot__grid">
      <div>
        <p class="kicker foot__h">Nous trouver</p>
        <address class="prose">
          {site.address.venue}<br />
          {site.address.street}<br />
          {site.address.zip} {site.address.city}
        </address>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="tlink">Itinéraire</a>
      </div>
      <div>
        <p class="kicker foot__h">Cours & stages</p>
        <ul class="prose">
          {site.teachers.map((t) => <li><a href={tel(t.phone)}>{t.name} — {t.phone}</a></li>)}
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
      <div>
        <p class="kicker foot__h">Location</p>
        <ul class="prose">
          <li><a href={sms(site.rentalPhone)}>SMS — {site.rentalPhone}</a></li>
          <li><a href={site.links.espace} target="_blank" rel="noopener">espacedaleas.fr</a></li>
        </ul>
      </div>
      <div>
        <p class="kicker foot__h">Suivre</p>
        <ul class="prose">
          {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>

  <p class="foot__word xl" aria-hidden="true">Daléas Danse</p>

  <div class="wrap">
    <div class="foot__bar label">
      <span>© {year} Daléas Danse — Annecy, depuis 1965</span>
      <nav aria-label="Pied de page" class="foot__nav">
        {navigation.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/mentions-legales/">Mentions légales</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .foot { padding: var(--section) 0 1.25rem; overflow: hidden; }
  .foot__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .foot__h { margin-bottom: 1.1rem; }
  .foot address { font-style: normal; margin-bottom: 0.9rem; }
  .foot ul a, .foot__nav a { color: var(--fg-muted); transition: color 0.3s var(--ease-out); }
  .foot ul a:hover, .foot__nav a:hover { color: var(--fg); }
  .foot__word {
    margin: clamp(4rem, 9vw, 7rem) 0 1.5rem;
    font-size: 11.2vw;
    line-height: 0.9;
    text-align: center;
    white-space: nowrap;
  }
  .foot__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    color: var(--fg-muted);
  }
  .foot__nav { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  @media (max-width: 900px) { .foot__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .foot__grid { grid-template-columns: 1fr; } }
</style>
