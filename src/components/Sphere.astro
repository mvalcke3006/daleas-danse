---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import yoga from '../assets/img/coursyogaannecy-marysedaleas.jpg';
import studio from '../assets/img/espacedaleas-salle1.jpg';
import duo from '../assets/img/daleasdansestage-web-copyrightdaleasdanse.jpg';
import team from '../assets/img/daleasdanse-contactdianeetdelphine.jpg';
import enfants from '../assets/img/cours-enfants-bleu.jpg';
import studioClass from '../assets/img/cours-studio-nb.jpg';
import ados from '../assets/img/cours-ados-nb.jpg';
import adultes from '../assets/img/cours-adultes-nb.jpg';
import creatif from '../assets/img/espace-activites-creatives.jpg';
import alain from '../assets/img/stage-alain-gruttadauria.jpg';
import fred from '../assets/img/stage-frederic-jean-baptiste.jpg';
import laure from '../assets/img/stage-laure-demolliere.jpg';
import pascal from '../assets/img/stage-pascal-loussouarn.jpg';
import coursEcole from '../assets/img/cours-ecole-adultes.jpg';
import eveil from '../assets/img/cours-eveil.jpg';
import rouge from '../assets/img/cours-modern-jazz-rouge.jpg';
import sp1 from '../assets/img/spectacle-1.jpg';
import sp2 from '../assets/img/spectacle-2.jpg';
import sp3 from '../assets/img/spectacle-3.jpg';
import sp5 from '../assets/img/spectacle-5.jpg';

const base = import.meta.env.BASE_URL;

type T = { src: ImageMetadata; r: string; pos: string; title: string; cap: string; href: string };
const H = 'horaires/', S = 'stages/', Y = 'yoga-annecy/', L = 'espace-daleas-location-de-salles-annecy/', C = 'contact-tel/';

const all: T[] = [
  { src: sp1, r: '16/10', pos: '50% 40%', title: 'Spectacle', cap: 'Toutes les classes sur scène', href: H },
  { src: eveil, r: '3/4', pos: '45% 40%', title: 'Éveil rythmique', cap: '2 ans ½ – 5 ans', href: H },
  { src: alain, r: '3/4', pos: '50% 30%', title: 'Alain Gruttadauria', cap: 'Modern Jazz, stage d’été', href: S },
  { src: studio, r: '4/3', pos: '30% 50%', title: 'Espace Daléas', cap: 'Trois studios à louer', href: L },
  { src: rouge, r: '3/4', pos: '40% 45%', title: 'Modern’Jazz', cap: 'Les plus jeunes', href: H },
  { src: sp2, r: '1/1', pos: '50% 45%', title: 'Spectacle', cap: 'Fin d’année', href: H },
  { src: yoga, r: '3/4', pos: '50% 35%', title: 'Yoga', cap: 'Viniyoga avec Maryse', href: Y },
  { src: ados, r: '4/3', pos: '55% 45%', title: 'Jazz ados', cap: 'Du 1er au 3e degré', href: H },
  { src: laure, r: '3/4', pos: '50% 35%', title: 'Laure Demollière', cap: 'Moderne, week-end', href: S },
  { src: team, r: '4/5', pos: '35% 50%', title: 'Diane & Delphine', cap: 'Diplômées d’État en jazz', href: C },
  { src: sp3, r: '16/10', pos: '50% 50%', title: 'Spectacle', cap: 'Classe chorégraphique', href: H },
  { src: enfants, r: '1/1', pos: '60% 50%', title: 'Initiation jazz', cap: '6 – 9 ans', href: H },
  { src: creatif, r: '4/3', pos: '50% 50%', title: 'Activités créatives', cap: 'À l’Espace Daléas', href: L },
  { src: fred, r: '3/4', pos: '50% 30%', title: 'Frédéric Jean-Baptiste', cap: 'Organic Dance Movement', href: S },
  { src: adultes, r: '1/1', pos: '40% 40%', title: 'Moderne', cap: 'Ados & adultes', href: H },
  { src: duo, r: '4/3', pos: '45% 30%', title: 'Stage d’été', cap: '32e édition', href: S },
  { src: coursEcole, r: '3/4', pos: '35% 50%', title: 'Jazz adultes', cap: 'Débutants à avancés', href: H },
  { src: sp5, r: '1/1', pos: '45% 60%', title: 'Spectacle', cap: 'Sur la scène', href: H },
  { src: pascal, r: '3/4', pos: '50% 35%', title: 'Pascal Loussouarn', cap: 'Chorégraphe invité', href: S },
  { src: studioClass, r: '4/3', pos: '75% 50%', title: 'En studio', cap: 'Cours réguliers', href: H },
];
const tiles = all;
const groupOf = (t: T) =>
  t.href === H ? 'Cours' : t.href === S ? 'Stages' : t.href === Y ? 'Yoga' : t.href === L ? 'Studios' : 'L’équipe';
const groups = ['Cours', 'Stages', 'Yoga', 'Studios', 'L’équipe'];

const imgs = await Promise.all(
  tiles.map((t) => getImage({ src: t.src, width: Math.min(t.src.width, 360), format: 'webp' }))
);
---
<section class="sph" data-sphere aria-label="Galerie de l’école">
  <div class="sph__stage">
    {tiles.map((t, i) => (
      <a
        href={`${base}${t.href}`}
        class="sph__tile"
        style={`aspect-ratio:${t.r}`}
        data-title={t.title}
        data-cap={t.cap}
        data-group={groupOf(t)}
        aria-label={`${t.title} — ${t.cap}`}
        draggable="false"
      >
        <img src={imgs[i].src} alt="" style={`object-position:${t.pos}`} draggable="false" loading={i < 10 ? 'eager' : 'lazy'} />
      </a>
    ))}
  </div>

  <div class="sph__ui">
    <p class="sph__count label" aria-live="polite"><span data-cur-n>01</span> / {String(tiles.length).padStart(2, '0')}</p>
    <div class="sph__caption" aria-hidden="true">
      <p class="sph__ct" data-cap-t>{tiles[0].title}</p>
      <p class="label muted" data-cap-c>{tiles[0].cap}</p>
    </div>
    <div class="sph__ctrls">
      <button class="sph__btn" data-prev aria-label="Photo précédente"><span aria-hidden="true">←</span></button>
      <button class="sph__btn sph__btn--play" data-play aria-label="Mettre en pause la rotation" aria-pressed="true"><span class="roll"><span class="roll__in" data-t="Pause" data-play-t>Pause</span></span></button>
      <button class="sph__btn" data-next aria-label="Photo suivante"><span aria-hidden="true">→</span></button>
    </div>
    <div class="sph__filters" role="group" aria-label="Centrer sur un thème">
      {groups.map((g) => <button class="sph__chip" data-group={g}>{g}</button>)}
    </div>
  </div>

  <div class="sph__tip" data-tip aria-hidden="true">
    <span class="sph__tip-title" data-tip-title></span>
    <span class="muted" data-tip-cap></span>
  </div>

  <div class="sph__foot label">
    <span>École de danse privée<br />Annecy</span>
    <span class="muted sph__hint">Glisser pour explorer</span>
    <span class="r">Modern’Jazz, Moderne<br />Classe chorégraphique, Yoga</span>
  </div>
</section>

<style>
  .sph {
    position: relative;
    z-index: 0;
    isolation: isolate;
    height: 100dvh;
    min-height: 560px;
    background: transparent;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .sph.is-drag { cursor: grabbing; }
  .sph__stage { position: absolute; inset: 0; }
  .sph__tile {
    --u: clamp(46px, 5.2vw, 84px);
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--u);
    margin-left: calc(var(--u) / -2);
    margin-top: calc(var(--u) / -2);
    background: var(--placeholder);
    will-change: transform, opacity;
    opacity: 0;
  }
  .sph__tile img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .sph__tile { transition: box-shadow 0.5s var(--ease-out); }
  .sph__tile.is-focus { box-shadow: 0 24px 50px -24px rgba(20, 22, 23, 0.6); }

  .sph__ui { position: absolute; inset: 0; z-index: 200; pointer-events: none; }
  .sph__ui > * { pointer-events: auto; }
  .sph__count { position: absolute; left: var(--side); top: clamp(6rem, 14vh, 8rem); font-feature-settings: 'tnum' 1; }
  .sph__caption { position: absolute; left: var(--side); top: calc(clamp(6rem, 14vh, 8rem) + 1.75rem); display: grid; gap: 0.35rem; pointer-events: none; }
  .sph__ct { font-size: clamp(1.6rem, 3vw, 2.8rem); font-weight: 300; line-height: 1; letter-spacing: var(--tr-h2); text-transform: uppercase; transition: opacity 0.3s var(--ease-out), transform 0.5s var(--ease-expo); }
  .sph__caption.is-swap .sph__ct { opacity: 0; transform: translateY(8px); }
  .sph__ctrls { position: absolute; right: var(--side); top: clamp(6rem, 14vh, 8rem); display: flex; align-items: center; gap: 6px; }
  .sph__btn {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 12px;
    letter-spacing: var(--tr-caps);
    text-transform: uppercase;
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .sph__btn span[aria-hidden] { font-size: 16px; line-height: 1; transition: transform 0.5s var(--ease-expo); }
  .sph__btn:hover { background: var(--plum); color: var(--white); box-shadow: none; }
  [data-prev]:hover span[aria-hidden] { transform: translateX(-3px); }
  [data-next]:hover span[aria-hidden] { transform: translateX(3px); }
  .sph__filters { position: absolute; left: 50%; bottom: clamp(3.5rem, 8vh, 5rem); translate: -50% 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 18px; width: max-content; max-width: calc(100% - 2 * var(--side)); }
  .sph__chip {
    padding: 6px 0;
    font-size: 12px;
    letter-spacing: var(--tr-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color 0.3s var(--ease-out), background-size 0.5s var(--ease-expo);
  }
  .sph__chip:hover { color: var(--plum); }
  .sph__chip.is-on { color: var(--ink); background-size: 100% 1px; }


  .sph__tip {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 70;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 12px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--white) 94%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05), 0 10px 24px -14px rgba(0, 0, 0, 0.35);
    font-size: 13px;
    line-height: 1.35;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }
  .sph__tip.is-on { opacity: 1; }
  .sph__tip-title { font-weight: 400; text-transform: uppercase; }

  .sph__foot {
    position: absolute;
    left: var(--side);
    right: var(--side);
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    pointer-events: none;
  }
  .sph__foot .r { text-align: right; }
  @media (max-width: 640px) {
    .sph__hint { display: none; }
    .sph__ctrls { top: auto; bottom: calc(clamp(3.5rem, 8vh, 5rem) + 3rem); right: 50%; translate: 50% 0; }
    .sph__count, .sph__caption { top: clamp(5.5rem, 12vh, 7rem); }
    .sph__tile { --u: clamp(40px, 12vw, 60px); }
    }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-sphere]').forEach((root) => {
    const tiles = [...root.querySelectorAll<HTMLElement>('.sph__tile')];
    const tip = root.querySelector<HTMLElement>('[data-tip]')!;
    const tipTitle = root.querySelector<HTMLElement>('[data-tip-title]')!;
    const tipCap = root.querySelector<HTMLElement>('[data-tip-cap]')!;
    const n = tiles.length;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const golden = Math.PI * (3 - Math.sqrt(5));
    const pts = tiles.map((_, i) => {
      const y = 1 - (i / (n - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const th = i * golden;
      return [Math.cos(th) * r, y, Math.sin(th) * r];
    });

    const curN = root.querySelector<HTMLElement>('[data-cur-n]')!;
    const capBox = root.querySelector<HTMLElement>('.sph__caption')!;
    const capT = root.querySelector<HTMLElement>('[data-cap-t]')!;
    const capC = root.querySelector<HTMLElement>('[data-cap-c]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const playT = root.querySelector<HTMLElement>('[data-play-t]')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.sph__chip')];
    let auto = !reduce, focus = -1, aimY = 0, aimX = -0.18, aiming = false, fz = 0;
    let ry = 0.4, rx = -0.18, vy = 0.0016, vx = 0;
    let open = reduce ? 1 : 0;
    let hovering = false, dragging = false, moved = 0, visible = true;
    let lastX = 0, lastY = 0, lastScroll = scrollY;
    let R = 1;

    const size = () => {
      const W = root.clientWidth, H = root.clientHeight;
      R = Math.min(W, H) * (W < 640 ? 0.36 : 0.3);
    };
    size();
    addEventListener('resize', size);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);

    const frame = () => {
      if (visible) {
        const target = hovering || !auto ? 0 : 0.0016;
        fz += ((focus >= 0 && !auto ? 1 : 0) - fz) * 0.08;
        if (aiming && !dragging) {
          const dy = aimY - ry;
          ry += dy * 0.08;
          rx += (aimX - rx) * 0.08;
          vy = 0; vx = 0;
          if (Math.abs(dy) < 0.0008) aiming = false;
        } else if (!dragging) {
          vy += (target - vy) * 0.04;
          vx *= 0.94;
          rx += vx;
          if (auto) rx += (-0.18 - rx) * 0.01;
        }
        if (!reduce && !aiming) ry += vy;
        const sY = Math.sin(ry), cY = Math.cos(ry), sX = Math.sin(rx), cX = Math.cos(rx);
        const f = R * 3.2;
        for (let i = 0; i < n; i++) {
          const [x0, y0, z0] = pts[i];
          const x1 = x0 * cY - z0 * sY;
          const z1 = x0 * sY + z0 * cY;
          const y2 = y0 * cX - z1 * sX;
          const z2 = y0 * sX + z1 * cX;
          const rr = R * open;
          const s = f / (f - z2 * rr);
          const depth = (z2 + 1) / 2;
          const el = tiles[i];
          const isF = i === focus;
          const zf = isF ? 1 + fz * 2.6 : 1;
          const dim = focus >= 0 && !isF ? 1 - fz * 0.6 : 1;
          el.style.transform = `translate3d(${(x1 * rr * s).toFixed(1)}px, ${(y2 * rr * s).toFixed(1)}px, 0) scale(${(s * (0.62 + depth * 0.38) * zf).toFixed(3)})`;
          el.style.opacity = String((open * (0.25 + depth * 0.75) * dim).toFixed(3));
          el.style.zIndex = String(isF && fz > 0.05 ? 150 : Math.round(depth * 100));
        }
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    const showCap = (i: number) => {
      curN.textContent = String(i + 1).padStart(2, '0');
      capBox.classList.add('is-swap');
      setTimeout(() => {
        capT.textContent = tiles[i].dataset.title || '';
        capC.textContent = tiles[i].dataset.cap || '';
        capBox.classList.remove('is-swap');
      }, 220);
    };
    const center = (i: number) => {
      const n2 = tiles.length;
      i = ((i % n2) + n2) % n2;
      focus = i;
      const [x0, y0, z0] = pts[i];
      let target = Math.atan2(x0, z0);
      const turns = Math.round((ry - target) / (Math.PI * 2));
      target += turns * Math.PI * 2;
      aimY = target;
      aimX = Math.max(-1, Math.min(1, Math.atan2(y0, Math.hypot(x0, z0))));
      aiming = true;
      setAuto(false);
      tiles.forEach((t, k) => t.classList.toggle('is-focus', k === i));
      chips.forEach((c) => c.classList.toggle('is-on', c.dataset.group === tiles[i].dataset.group));
      showCap(i);
    };
    const setAuto = (on: boolean) => {
      auto = on;
      playBtn.setAttribute('aria-pressed', String(on));
      playBtn.setAttribute('aria-label', on ? 'Mettre en pause la rotation' : 'Relancer la rotation');
      const label = on ? 'Pause' : 'Rotation';
      playT.textContent = label;
      playT.dataset.t = label;
      if (on) { focus = -1; tiles.forEach((t) => t.classList.remove('is-focus')); chips.forEach((c) => c.classList.remove('is-on')); }
    };
    root.querySelector('[data-next]')!.addEventListener('click', () => center(focus + 1));
    root.addEventListener('pointerdown', (e) => { if (!(e.target as Element).closest('.sph__ui, .sph__tile') && focus >= 0) { setAuto(true); } });
    root.querySelector('[data-prev]')!.addEventListener('click', () => center(focus < 0 ? tiles.length - 1 : focus - 1));
    playBtn.addEventListener('click', () => setAuto(!auto));
    chips.forEach((c) => c.addEventListener('click', () => {
      const list = tiles.map((t, k) => (t.dataset.group === c.dataset.group ? k : -1)).filter((k) => k >= 0);
      const cur = list.indexOf(focus);
      center(list[(cur + 1) % list.length]);
    }));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') center(focus + 1);
      if (e.key === 'ArrowLeft') center(focus < 0 ? tiles.length - 1 : focus - 1);
    });
    if (reduce) setAuto(false);

    const reveal = () => {
      if (reduce) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 1600);
        open = 1 - Math.pow(1 - p, 4);
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    if (document.documentElement.classList.contains('is-loaded')) reveal();
    else addEventListener('dd:ready', reveal, { once: true });

    root.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;
      if ((e.target as Element).closest('.sph__ui')) return;
      dragging = true; aiming = false; moved = 0; lastX = e.clientX; lastY = e.clientY;
      root.classList.add('is-drag');
    });
    addEventListener('pointermove', (e) => {
      if (dragging) {
        const dx = e.clientX - lastX, dy = e.clientY - lastY;
        moved += Math.abs(dx) + Math.abs(dy);
        vy = dx * 0.004; vx = dy * 0.003;
        ry += vy; rx = Math.max(-1, Math.min(1, rx + vx));
        lastX = e.clientX; lastY = e.clientY;
      }
      if (tip.classList.contains('is-on')) tip.style.transform = `translate(${e.clientX + 16}px, ${e.clientY + 16}px)`;
    }, { passive: true });
    addEventListener('pointerup', () => { dragging = false; root.classList.remove('is-drag'); });
    root.addEventListener('click', (e) => { if (moved > 8) e.preventDefault(); }, true);

    addEventListener('scroll', () => {
      if (!reduce) vy += (scrollY - lastScroll) * 0.00012;
      lastScroll = scrollY;
    }, { passive: true });

    tiles.forEach((el) => {
      el.addEventListener('pointerenter', (e) => {
        hovering = true;
        tipTitle.textContent = el.dataset.title || '';
        tipCap.textContent = el.dataset.cap || '';
        tip.style.transform = `translate(${e.clientX + 16}px, ${e.clientY + 16}px)`;
        tip.classList.add('is-on');
      });
      el.addEventListener('pointerleave', () => { hovering = false; tip.classList.remove('is-on'); });
    });
  });
</script>
