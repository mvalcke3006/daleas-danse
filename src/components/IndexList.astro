---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  label: string;
  meta: string;
  href: string;
  img: ImageMetadata;
  pos?: string;
}
interface Props {
  items: Item[];
  start?: number;
}
const { items, start = 1 } = Astro.props;
const shots = await Promise.all(items.map((it) => getImage({ src: it.img, width: 560, format: 'webp' })));
const pad = (n: number) => String(n).padStart(2, '0');
---
<ul class="ix" data-ix>
  {items.map((it, i) => (
    <li>
      <a href={it.href} class="ix__row" data-img={shots[i].src} data-pos={it.pos || '50% 50%'} style={`--d:${(i * 0.05).toFixed(2)}s`}>
        <span class="ix__n">{pad(i + start)}</span>
        <span class="ix__mask"><span class="ix__t">{it.label}</span></span>
        <span class="ix__m">{it.meta}</span>
        <span class="ix__a" aria-hidden="true"></span>
      </a>
    </li>
  ))}
</ul>
<div class="ix__float" data-ix-float aria-hidden="true"><img alt="" /></div>

<style>
  .ix { border-top: 1px solid var(--ink); }
  .ix li { border-bottom: 1px solid var(--line); }
  .ix__row {
    display: grid;
    grid-template-columns: clamp(2.5rem, 6vw, 5rem) minmax(0, 1fr) auto 2rem;
    align-items: center;
    column-gap: clamp(1rem, 2vw, 2rem);
    padding: clamp(0.5rem, 1.2vw, 1rem) 0;
    transition: color 0.45s var(--ease-out);
  }
  .ix__n, .ix__m {
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: var(--tr-caps);
    text-transform: uppercase;
    font-feature-settings: 'case' 1, 'tnum' 1;
  }
  .ix__n { align-self: start; padding-top: 0.9em; color: var(--fg-muted); }
  .ix__m { text-align: right; color: var(--fg-muted); transition: color 0.45s var(--ease-out); }
  .ix__mask { display: block; overflow: hidden; padding: 0.08em 0 0.04em; }
  .ix__t {
    display: inline-block;
    font-size: clamp(2.4rem, 6.6vw, 6.8rem);
    font-weight: 200;
    line-height: 0.98;
    letter-spacing: var(--tr-h1);
    text-transform: uppercase;
    font-feature-settings: 'case' 1;
    white-space: nowrap;
    transform: translate3d(0, 105%, 0);
    transition: transform 1.2s var(--ease-expo) var(--d), letter-spacing 0.8s var(--ease-expo);
  }
  .ix.is-in .ix__t { transform: none; }
  .ix__a { position: relative; justify-self: end; width: 14px; height: 14px; opacity: 0; transform: translateX(-8px); transition: opacity 0.4s var(--ease-out), transform 0.6s var(--ease-expo); }
  .ix__a::before { content: ''; position: absolute; inset: 2px; border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: rotate(45deg); }

  .ix:hover .ix__row { color: color-mix(in srgb, var(--fg) 26%, transparent); }
  .ix .ix__row:hover { color: var(--fg); }
  .ix .ix__row:hover .ix__t { letter-spacing: 0.012em; }
  .ix .ix__row:hover .ix__m { color: var(--fg); }
  .ix .ix__row:hover .ix__a { opacity: 1; transform: none; }

  .ix__float {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: clamp(220px, 20vw, 340px);
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    filter: blur(12px);
    scale: 0.86;
    rotate: -4deg;
    transition: opacity 0.4s var(--ease-out), filter 0.5s var(--ease-out), scale 0.8s var(--ease-expo), rotate 0.8s var(--ease-expo);
    box-shadow: 0 30px 60px -30px rgba(20, 22, 23, 0.5);
  }
  .ix__float.is-on { opacity: 1; filter: none; scale: 1; rotate: 0deg; }
  .ix__float img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 700px) {
    .ix__row { grid-template-columns: 2.25rem minmax(0, 1fr) 1rem; row-gap: 0.15rem; padding: 0.85rem 0; }
    .ix__t { font-size: clamp(2rem, 10.5vw, 3.2rem); }
    .ix__m { grid-column: 2; grid-row: 2; text-align: left; }
    .ix__a { grid-column: 3; grid-row: 1 / 3; opacity: 0.5; transform: none; }
    .ix__n { padding-top: 0.6em; }
  }
  @media (hover: none), (pointer: coarse) { .ix__float { display: none; } }
  @media (prefers-reduced-motion: reduce) { .ix__t { transform: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ix]').forEach((list) => {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      list.classList.add('is-in');
      io.disconnect();
    }, { threshold: 0.15 });
    io.observe(list);

    const float = list.nextElementSibling as HTMLElement | null;
    if (!float || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const img = float.querySelector('img')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rows = [...list.querySelectorAll<HTMLElement>('.ix__row')];
    let x = 0, y = 0, cx = 0, cy = 0, on = false, raf = 0, warm = false;
    const follow = () => {
      const k = reduce ? 1 : 0.14;
      cx += (x - cx) * k;
      cy += (y - cy) * k;
      const w = float.offsetWidth, h = float.offsetHeight;
      const fx = Math.min(innerWidth - w - 16, cx + 32), fy = Math.max(16, Math.min(innerHeight - h - 16, cy - h / 2));
      float.style.transform = `translate3d(${fx.toFixed(1)}px, ${fy.toFixed(1)}px, 0)`;
      raf = on || Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(follow) : 0;
    };
    rows.forEach((row) => {
      row.addEventListener('pointerenter', (e) => {
        if (!warm) { warm = true; rows.forEach((r) => { const p = new Image(); p.src = r.dataset.img || ''; }); }
        img.src = row.dataset.img || '';
        img.style.objectPosition = row.dataset.pos || '50% 50%';
        if (!on) { cx = x = e.clientX; cy = y = e.clientY; }
        on = true;
        float.classList.add('is-on');
        if (!raf) raf = requestAnimationFrame(follow);
      });
      row.addEventListener('pointerleave', () => { on = false; float.classList.remove('is-on'); });
    });
    list.addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; }, { passive: true });
  });
</script>
