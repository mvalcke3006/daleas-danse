---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  lines: string[];
  label: string;
  pos?: string;
}
const { image, alt, lines, label, pos = '50% 50%' } = Astro.props;
const N = 7;
const shot = await getImage({ src: image, width: Math.min(image.width, 1600), format: 'webp' });
let k = 0;
const words = lines.map((l) => l.split(' ').map((w) => ({ w, k: k++ })));
---
<section class="sc" data-scene aria-label={alt} style={`--n:${N}`}>
  <div class="sc__sticky">
    <div class="sc__frame" data-scene-frame>
      {Array.from({ length: N }, (_, i) => (
        <div class="sc__slice" style={`--i:${i}; --dir:${i % 2 ? 1 : -1}`}>
          <img src={shot.src} alt={i === 0 ? alt : ''} style={`object-position:${pos}`} loading="lazy" decoding="async" draggable="false" />
        </div>
      ))}
    </div>

    <p class="sc__txt" aria-hidden="true">
      {words.map((line) => (
        <span class="sc__line">{line.map(({ w, k }) => <span class="sc__w" style={`--k:${k}`}>{w}</span>)}</span>
      ))}
    </p>
    <p class="sr-only">{lines.join(' ')}</p>

    <div class="sc__end">
      <slot><p class="label">{label}</p></slot>
    </div>
  </div>
</section>

<style>
  .sc {
    --a: 0;
    --s: 0;
    --d: 0;
    position: relative;
    height: 360vh;
  }
  .sc__sticky {
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .sc__frame {
    position: absolute;
    width: min(84vw, 1320px);
    height: min(74vh, 780px);
    clip-path: inset(calc((1 - var(--a)) * 47%) calc((1 - var(--a)) * 49.6%) round 6px);
    transform: scale(calc(1.22 - var(--a) * 0.22 - var(--d) * 0.42)) rotate(calc(var(--d) * -2.5deg));
    box-shadow: var(--shx, 0px) var(--shy, 22px) 60px -30px rgba(20, 22, 23, 0.5);
  }
  .sc__slice {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--i) * 100% / var(--n));
    height: calc(100% / var(--n) + 1px);
    overflow: hidden;
    transform: translate3d(calc(var(--dir) * var(--s) * (2.5vw + var(--i) * 1.1vw)), 0, 0);
    will-change: transform;
  }
  .sc__slice img {
    position: absolute;
    left: 0;
    top: calc(var(--i) * -100%);
    width: 100%;
    height: calc(var(--n) * 100%);
    max-width: none;
    object-fit: cover;
    transform: scale(calc(1 + var(--s) * 0.08));
  }

  .sc__txt {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    padding-inline: var(--side);
    color: #fff;
    mix-blend-mode: difference;
    font-size: clamp(2.2rem, 7.4vw, 8rem);
    font-weight: 200;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    text-align: center;
    pointer-events: none;
    transform: translate3d(0, calc(var(--d) * -14vh), 0);
    opacity: calc(1 - var(--d) * 1.2);
  }
  .sc__line { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 0.28em; }
  .sc__line:nth-child(2) { font-style: italic; font-weight: 300; }
  .sc__w {
    display: inline-block;
    opacity: 0;
    filter: blur(12px);
    transform: translate3d(0, 0.35em, 0) rotate(3deg);
    transition: opacity 0.7s var(--ease-out), filter 0.7s var(--ease-out), transform 0.9s var(--ease-expo);
  }
  .sc__w.is-on { opacity: 1; filter: none; transform: none; }

  .sc__end {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(clamp(70px, 13vh, 150px) + 0.5rem);
    display: flex;
    justify-content: center;
    opacity: var(--d);
    transform: translate3d(0, calc((1 - var(--d)) * 24px), 0);
  }

  @media (max-width: 700px) {
    .sc { height: 300vh; }
    .sc__frame { width: calc(100vw - 2 * var(--side)); height: 62vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc { height: auto; }
    .sc__sticky { position: relative; min-height: 100dvh; }
    .sc__frame { clip-path: none; transform: none; }
    .sc__slice, .sc__slice img { transform: none; }
    .sc__w { opacity: 1; filter: none; transform: none; }
    .sc__txt { transform: none; opacity: 1; }
    .sc__end { opacity: 1; transform: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((root) => {
    if (reduce) return;
    const words = [...root.querySelectorAll<HTMLElement>('.sc__w')];
    const seg = (p: number, s: number, e: number) => Math.min(1, Math.max(0, (p - s) / (e - s)));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    let visible = false, last = -1;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { rootMargin: '20% 0px' }).observe(root);
    const tick = () => {
      if (visible) {
        const r = root.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
        if (Math.abs(p - last) > 0.0005) {
          last = p;
          const a = ease(seg(p, 0, 0.24));
          const b = seg(p, 0.16, 0.5);
          const s = Math.sin(seg(p, 0.46, 0.8) * Math.PI);
          const d = ease(seg(p, 0.8, 0.97));
          root.style.setProperty('--a', a.toFixed(4));
          root.style.setProperty('--s', s.toFixed(4));
          root.style.setProperty('--d', d.toFixed(4));
          const on = Math.round(b * words.length);
          words.forEach((w, i) => w.classList.toggle('is-on', i < on));
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
