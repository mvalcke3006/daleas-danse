---
import { getImage } from 'astro:assets';
import figure from '../assets/img/daleas-figure.png';
import kids from '../assets/img/coursinitiationjazz_daleasdanse.jpg';
import jazz from '../assets/img/coursdansemodernjazz_daleasdanseannecy.jpg';
import duo from '../assets/img/daleasdansestage-web-copyrightdaleasdanse.jpg';
import yoga from '../assets/img/coursyogaannecy-marysedaleas.jpg';
import gala from '../assets/img/daleasdanse-slide4.jpg';
import studio from '../assets/img/espacedaleas-salle1.jpg';
import team from '../assets/img/daleasdanse-contactdianeetdelphine.jpg';

const base = import.meta.env.BASE_URL;
const logo = await getImage({ src: figure, width: 574, format: 'webp' });

const photos = [
  { src: team, x: -0.3, y: -0.3, w: 0.27, r: -4, z: 'b', ratio: '4/3', pos: '40% 50%', href: 'ecole/', label: 'L’école' },
  { src: gala, x: 0.33, y: -0.17, w: 0.31, r: 5, z: 'b', ratio: '16/10', pos: '50% 40%', href: 'galerie/', label: 'Galerie' },
  { src: jazz, x: -0.36, y: 0.19, w: 0.24, r: 3, z: 'b', ratio: '3/4', pos: '50% 50%', href: 'horaires/', label: 'Cours' },
  { src: duo, x: 0.31, y: 0.31, w: 0.25, r: -6, z: 'b', ratio: '1/1', pos: '45% 30%', href: 'stages/', label: 'Stages' },
  { src: studio, x: 0.03, y: -0.47, w: 0.24, r: 2, z: 'b', ratio: '4/3', pos: '30% 50%', href: 'espace-daleas-location-de-salles-annecy/', label: 'Location' },
  { src: kids, x: -0.06, y: 0.45, w: 0.22, r: -3, z: 'b', ratio: '4/3', pos: '50% 30%', href: 'horaires/', label: 'Éveil' },
  { src: kids, x: -0.53, y: -0.1, w: 0.2, r: -8, z: 'f', ratio: '3/4', pos: '50% 40%', href: 'horaires/', label: 'Initiation jazz' },
  { src: yoga, x: 0.56, y: 0.07, w: 0.21, r: 7, z: 'f', ratio: '3/4', pos: '50% 35%', href: 'yoga-annecy/', label: 'Yoga' },
  { src: duo, x: -0.23, y: -0.53, w: 0.17, r: 6, z: 'f', ratio: '4/5', pos: '58% 20%', href: 'stages/', label: 'Moderne' },
  { src: jazz, x: 0.27, y: -0.5, w: 0.17, r: -5, z: 'f', ratio: '1/1', pos: '80% 30%', href: 'horaires/', label: 'Jazz adultes' },
  { src: gala, x: -0.49, y: 0.41, w: 0.21, r: 5, z: 'f', ratio: '4/3', pos: '25% 30%', href: 'galerie/', label: 'Spectacle' },
  { src: team, x: 0.5, y: 0.43, w: 0.18, r: -4, z: 'f', ratio: '4/5', pos: '65% 50%', href: 'contact-tel/', label: 'Contact' },
  { src: studio, x: -0.8, y: -0.31, w: 0.18, r: -3, z: 'b', ratio: '3/4', pos: '72% 50%', href: 'espace-daleas-location-de-salles-annecy/', label: 'Studios' },
  { src: gala, x: 0.82, y: -0.34, w: 0.19, r: 4, z: 'f', ratio: '1/1', pos: '78% 40%', href: 'galerie/', label: 'Scène' },
  { src: yoga, x: -0.84, y: 0.21, w: 0.16, r: 6, z: 'f', ratio: '1/1', pos: '50% 80%', href: 'yoga-annecy/', label: 'Viniyoga' },
  { src: duo, x: 0.85, y: 0.3, w: 0.17, r: -6, z: 'b', ratio: '4/3', pos: '50% 50%', href: 'stages/', label: 'Stage d’été' },
];
const shots = await Promise.all(photos.map((p) => getImage({ src: p.src, width: 520, format: 'webp' })));
---
<section class="hf" data-hf aria-label="Daléas Danse">
  <div class="hf__light" aria-hidden="true">
    <span class="hf__beam hf__beam--l"></span>
    <span class="hf__beam hf__beam--r"></span>
    <span class="hf__spot"></span>
  </div>

  <div class="hf__stage">
    {photos.map((p, i) => (
      <a
        href={`${base}${p.href}`}
        class:list={['hf__p', p.z === 'f' ? 'is-front' : 'is-back', Math.abs(p.x) > 0.7 && 'is-outer']}
        style={`--x:${p.x}; --y:${p.y}; --w:${p.w}; --r:${p.r}deg; --i:${i}; aspect-ratio:${p.ratio}`}
        aria-label={p.label}
      >
        <span class="hf__pin lit"><img src={shots[i].src} alt="" style={`object-position:${p.pos}`} loading="eager" draggable="false" /></span>
      </a>
    ))}

    <div class="hf__logo" data-hf-logo>
      <div class="hf__logo-in" data-hf-logo-in>
        <img src={logo.src} alt="Daléas Danse" width="287" height="495" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>

<style>
  .hf {
    --lx: 50%;
    --ly: 32%;
    position: relative;
    height: 100dvh;
    min-height: 640px;
    overflow: hidden;
    isolation: isolate;
    background: #ececeb;
  }

  .hf__light { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hf__spot {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at var(--lx) var(--ly), #fff 0%, rgba(255, 255, 255, 0.85) 16%, rgba(255, 255, 255, 0) 52%),
      radial-gradient(ellipse 80% 60% at 50% 45%, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0) 70%);
  }
  .hf__beam {
    position: absolute;
    top: -20%;
    width: 60%;
    height: 140%;
    background: conic-gradient(from 180deg at 50% 0%, transparent 0deg, rgba(255, 255, 255, 0.6) 10deg, transparent 22deg);
    filter: blur(14px);
    mix-blend-mode: screen;
    transform-origin: 50% 0%;
    animation: sweep 14s var(--ease-in-out) infinite alternate;
  }
  .hf__beam--l { left: -10%; --a: -18deg; --b: 12deg; }
  .hf__beam--r { right: -10%; --a: 16deg; --b: -14deg; animation-delay: -6s; }
  @keyframes sweep { from { transform: rotate(var(--a)); } to { transform: rotate(var(--b)); } }

  .hf__stage {
    --L: clamp(340px, min(67vh, 58vw), 680px);
    --cy: 55%;
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .hf__p {
    position: absolute;
    left: calc(50% + var(--x) * var(--L));
    top: calc(var(--cy) + var(--y) * var(--L));
    width: calc(var(--w) * var(--L));
    translate: -50% -50%;
    z-index: 1;
    opacity: 0;
    scale: 0.92;
    transition: opacity 1s var(--ease-out), scale 1.4s var(--ease-expo);
    transition-delay: calc(var(--i) * 80ms + 350ms);
  }
  .hf__p.is-front { z-index: 4; }
  .hf.is-in .hf__p { opacity: 1; scale: 1; }
  .hf__p:hover { z-index: 5; }
  .hf__pin {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    rotate: var(--r);
    transition: rotate 0.7s var(--ease-expo), scale 0.7s var(--ease-expo);
  }
  .hf__p:hover .hf__pin { rotate: 0deg; scale: 1.05; }
  .hf__pin img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }

  .hf__logo {
    position: absolute;
    left: 50%;
    top: var(--cy);
    z-index: 3;
    height: var(--L);
    aspect-ratio: 287 / 495;
    translate: -50% -50%;
    perspective: 1000px;
    pointer-events: none;
  }
  .hf__logo-in { width: 100%; height: 100%; will-change: transform; }
  .hf__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(var(--sx, 0px) var(--sy, 22px) 18px rgba(20, 22, 23, 0.26));
    animation: logo-in 1.8s var(--ease-expo) 0.05s backwards;
  }
  @keyframes logo-in { from { opacity: 0; filter: blur(18px); transform: scale(0.94); } }

  @media (max-width: 760px), (max-aspect-ratio: 4/5) {
    .hf__stage { --L: min(52vh, 110vw, 560px); --cy: 54%; }
    .hf__p.is-outer { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hf__beam, .hf__logo img { animation: none; }
    .hf__p { transition: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hf]');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const logo = root.querySelector<HTMLElement>('[data-hf-logo]')!;
    const inner = root.querySelector<HTMLElement>('[data-hf-logo-in]')!;

    requestAnimationFrame(() => root.classList.add('is-in'));

    let mx = 0, my = -0.1, cmx = 0, cmy = -0.1, visible = true;
    if (fine) {
      root.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        mx = (e.clientX - r.left) / r.width - 0.5;
        my = (e.clientY - r.top) / r.height - 0.5;
      }, { passive: true });
      root.addEventListener('pointerleave', () => { mx = 0; my = -0.1; });
    }
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);

    const tick = (time: number) => {
      if (visible) {
        const t = time / 1000;
        if (!fine && !reduce) { mx = Math.sin(t * 0.35) * 0.3; my = Math.cos(t * 0.27) * 0.2 - 0.1; }
        cmx += (mx - cmx) * 0.07;
        cmy += (my - cmy) * 0.07;
        const scroll = Math.max(0, -root.getBoundingClientRect().top);
        const fl = reduce ? 0 : 1;

        root.style.setProperty('--lx', `${(50 + cmx * 70).toFixed(2)}%`);
        root.style.setProperty('--ly', `${(32 + cmy * 60).toFixed(2)}%`);
        logo.style.setProperty('--sx', `${(-cmx * 46).toFixed(1)}px`);
        logo.style.setProperty('--sy', `${(22 - cmy * 34).toFixed(1)}px`);

        inner.style.transform =
          `translate3d(${(cmx * 34 * fl).toFixed(1)}px, ${(cmy * 22 * fl + Math.sin(t * 0.9) * 8 * fl - scroll * 0.15).toFixed(1)}px, 0) ` +
          `rotateX(${(-cmy * 16 * fl).toFixed(2)}deg) rotateY(${(cmx * 24 * fl).toFixed(2)}deg) ` +
          `rotateZ(${(Math.sin(t * 0.6) * 2 * fl + cmx * 4 * fl).toFixed(2)}deg) scale(${(1 + Math.sin(t * 0.45) * 0.012 * fl).toFixed(4)})`;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
