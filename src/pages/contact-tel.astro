---
import Base from '../layouts/Base.astro';
import FloatHero from '../components/FloatHero.astro';
import eveil from '../assets/img/cours-eveil.jpg';
import sp1 from '../assets/img/spectacle-1.jpg';
import sp2 from '../assets/img/spectacle-2.jpg';
import kids from '../assets/img/coursinitiationjazz_daleasdanse.jpg';
import team from '../assets/img/daleasdanse-contactdianeetdelphine.jpg';
import { site, tel, sms } from '../data/site';
const address = `${site.address.street}, ${site.address.zip} ${site.address.city}`;
---
<Base
  title="Contact"
  description="Pour toute demande sur les cours de danse et les stages, contactez Diane ou Delphine Daléas par téléphone. Espace Daléas, 2bis rue Louis Chaumontel, Annecy."
  image="/og/contact.jpg"
>
  <FloatHero
    variant="orbit"
    title="Contact"
    accent="un appel suffit"
    left="Diane & Delphine"
    right="Annecy"
    photos={[
      { src: team, ratio: '4/3', pos: '40% 45%' },
      { src: kids, ratio: '3/4', pos: '55% 40%' },
      { src: sp2, ratio: '4/3', pos: '50% 45%' },
      { src: eveil, ratio: '3/4', pos: '45% 40%' },
      { src: sp1, ratio: '4/3', pos: '50% 40%' },
    ]}
  />

  <section class="ct wrap">
    <div class="ct__top">
      <p class="label muted">Contact</p>
      <p class="label muted">Un appel suffit</p>
    </div>

    {site.teachers.map((t, i) => (
      <a href={tel(t.phone)} class="ct__row" data-reveal style={`--d:${i * 0.1}s`}>
        <span class="ct__who"><span class="label">{t.name}</span><span class="label muted">Cours & stages — appeler</span></span>
        <span class="ct__num" data-fitnum>{t.phone}</span>
      </a>
    ))}
  </section>

  <section class="ct-info wrap sec">
    <div class="ct-info__c">
      <p class="label muted">Adresse</p>
      <p class="ct-info__big">{site.address.venue}</p>
      <p class="prose">{address}</p>
      <div class="ct-info__act">
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="tlink">Itinéraire ↗</a>
        <button class="tlink" data-copy={address}><span data-copy-t>Copier l’adresse</span></button>
      </div>
    </div>
    <div class="ct-info__c">
      <p class="label muted">Location de salles</p>
      <p class="ct-info__big"><a href={sms(site.rentalPhone)}>{site.rentalPhone}</a></p>
      <p class="prose"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="ct-info__act"><a href={sms(site.rentalPhone)} class="tlink">Envoyer un SMS</a></div>
    </div>
    <div class="ct-info__c">
      <p class="label muted">Suivre</p>
      {site.socials.map((s) => <p class="ct-info__big"><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></p>)}
    </div>
  </section>
</Base>

<style>
  .ct { padding-top: var(--section); }
  .ct__top { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--ink); }
  .ct__row { display: block; padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(1rem, 2vw, 1.5rem); border-bottom: 1px solid var(--line); transition: color 0.4s var(--ease-out); }
  .ct__who { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }
  .ct__num {
    display: inline-block;
    font-size: 15vw;
    font-weight: 200;
    line-height: 0.82;
    letter-spacing: -0.035em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .ct__row:hover { color: var(--plum); }

  .ct-info { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem clamp(1.5rem, 4vw, 4rem); }
  .ct-info__c { display: grid; align-content: start; gap: 0.7rem; padding-top: 1.25rem; border-top: 1px solid var(--ink); }
  .ct-info__big { font-size: clamp(1.4rem, 2.4vw, 2.2rem); font-weight: 300; line-height: 1.1; letter-spacing: var(--tr-h2); text-transform: uppercase; }
  .ct-info__big a, .ct-info .prose a { transition: color 0.3s var(--ease-out); }
  .ct-info__big a:hover, .ct-info .prose a:hover { color: var(--plum); }
  .ct-info__act { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-top: 0.5rem; }

  @media (max-width: 900px) {
    .ct-info { grid-template-columns: 1fr; }
    .ct__who { flex-direction: column; gap: 0.2rem; }
  }
</style>

<script>
  const nums = [...document.querySelectorAll<HTMLElement>('[data-fitnum]')];
  const fit = () => {
    nums.forEach((n) => {
      n.style.fontSize = '100px';
      const w = n.getBoundingClientRect().width;
      const target = (n.parentElement as HTMLElement).getBoundingClientRect().width;
      n.style.fontSize = `${Math.floor((target / w) * 100 * 0.985 * 10) / 10}px`;
    });
  };
  document.fonts.ready.then(() => { fit(); setTimeout(fit, 400); });
  addEventListener('resize', fit);

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      const label = b.querySelector<HTMLElement>('[data-copy-t]')!;
      try {
        await navigator.clipboard.writeText(b.dataset.copy || '');
        label.textContent = 'Adresse copiée';
      } catch {
        label.textContent = b.dataset.copy || '';
      }
      setTimeout(() => { label.textContent = 'Copier l’adresse'; }, 2200);
    });
  });
</script>
