---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { site, tel, sms } from '../data/site';
import team from '../assets/img/daleasdanse-contactdianeetdelphine.jpg';
---
<Base
  title="Contact"
  description="Pour toute demande sur les cours de danse et les stages, contactez Diane ou Delphine Daléas par téléphone. Espace Daléas, 2bis rue Louis Chaumontel, Annecy."
>
  <PageHero kicker="Nous" accent="contacter" image={team} pos="40% 45%">
    Contact<br /><em>un appel suffit</em>
    <Fragment slot="sub">Joignez directement Diane ou Delphine par téléphone.</Fragment>
  </PageHero>

  <section class="wrap sec sec--tight">
    <SectionHead n="01" label="Cours & stages">Diane<br /><em>& Delphine</em></SectionHead>
    <div class="pcards cols">
      {site.teachers.map((t, i) => (
        <a href={tel(t.phone)} class="pcard" data-reveal style={`--d:${i * 0.08}s`}>
          <span class="label">{t.name} — appeler</span>
          <span class="pcard__tel xl">{t.phone}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap sec">
    <SectionHead n="02" label="Infos">Nous trouver</SectionHead>
    <div class="cols" style="--n:3">
      <div class="info" data-reveal>
        <p class="label muted">Adresse</p>
        <p class="prose">{site.address.venue}<br />{site.address.street}<br />{site.address.zip} {site.address.city}</p>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="tlink">Itinéraire</a>
      </div>
      <div class="info" data-reveal style="--d:.06s">
        <p class="label muted">Location de salles</p>
        <p class="prose"><a href={sms(site.rentalPhone)}>SMS — {site.rentalPhone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="info" data-reveal style="--d:.12s">
        <p class="label muted">Suivre</p>
        <p class="prose">{site.socials.map((s) => <><a href={s.href} target="_blank" rel="noopener">{s.label}</a><br /></>)}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .info { display: grid; gap: 1rem; align-content: start; padding-top: 1.25rem; border-top: 1px solid var(--ink); justify-items: start; }
  .info .prose a { transition: color 0.3s var(--ease-out); }
  .info .prose a:hover { color: var(--plum); }
</style>
