---
import Base from '../layouts/Base.astro';
import TitleHero from '../components/TitleHero.astro';
import jazz from '../assets/img/coursdansemodernjazz_daleasdanseannecy.jpg';
import { schedule, days, season } from '../data/site';

const toMin = (t: string) => {
  const [h, m] = t.split('h').map(Number);
  return h * 60 + (m || 0);
};
const START = 12 * 60;
const END = 22 * 60;
const hours = Array.from({ length: (END - START) / 60 + 1 }, (_, i) => 12 + i);

const byDay = days.map((day) => {
  const items = schedule
    .flatMap((d) => d.slots.filter((s) => s.day === day).map((s) => ({ ...s, disc: d, a: toMin(s.start), b: toMin(s.end) })))
    .sort((x, y) => x.a - y.a);
  const out: Array<(typeof items)[number] & { lane: number; lanes: number }> = [];
  let cluster: Array<(typeof items)[number] & { lane: number }> = [];
  let clusterEnd = -1;
  let lanes: number[] = [];
  const flush = () => {
    const n = Math.max(1, lanes.length);
    cluster.forEach((it) => out.push({ ...it, lanes: n }));
    cluster = [];
    lanes = [];
  };
  items.forEach((it) => {
    if (it.a >= clusterEnd) { flush(); clusterEnd = it.b; }
    clusterEnd = Math.max(clusterEnd, it.b);
    let lane = lanes.findIndex((end) => end <= it.a);
    if (lane === -1) { lane = lanes.length; lanes.push(it.b); } else lanes[lane] = it.b;
    cluster.push({ ...it, lane });
  });
  flush();
  return { day, items: out };
});
const total = schedule.reduce((n, d) => n + d.slots.length, 0);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Horaires des cours"
  description={`Horaires ${season} des cours de danse Daléas à Annecy : éveil rythmique, initiation jazz, jazz ados et adultes, moderne, classe chorégraphique.`}
  image="/og/horaires.jpg"
>
  <TitleHero title="Horaires" accent={`${total} cours par semaine`} left={`Planning ${season}`} right="Du lundi au vendredi" />

  <section class="hh wrap">
    <div class="hh__top">
      <p class="label muted">Le planning</p>
      <p class="label muted" data-today-label>Du lundi au vendredi</p>
    </div>
    <div class="hh__row">
      <p class="lead">{total} cours par semaine, de l’éveil rythmique dès 2 ans ½ aux classes avancées.</p>
      <div class="hh__filters" role="group" aria-label="Mettre en avant une discipline">
        <button class="hf-chip" aria-pressed="true" data-filter="all">Tout</button>
        {schedule.map((d) => <button class="hf-chip" aria-pressed="false" data-filter={d.id}>{d.name}</button>)}
      </div>
    </div>
  </section>

  <section class="agenda wrap" data-agenda style={`--rows:${hours.length - 1}`}>
    <div class="agenda__hours" aria-hidden="true">
      {hours.map((h) => <span style={`--h:${h - 12}`}>{pad(h)}h</span>)}
    </div>
    {byDay.map(({ day, items }, di) => (
      <div class="agenda__col" data-day={di + 1}>
        <p class="agenda__day"><span>{day}</span><em>Aujourd’hui</em></p>
        <div class="agenda__track">
          {hours.slice(0, -1).map((h) => <i class="agenda__line" style={`--h:${h - 12}`} />)}
          {items.map((it) => (
            <button
              type="button"
              class:list={['ev', it.b - it.a < 55 && 'ev--short']}
              data-disc={it.disc.id}
              data-day-name={day}
              data-time={`${it.start} – ${it.end}`}
              data-level={it.level}
              aria-haspopup="dialog"
              style={`--t:${(it.a - START) / 60}; --len:${(it.b - it.a) / 60}; --lane:${it.lane}; --lanes:${it.lanes}`}
            >
              <span class="ev__time">{it.start} – {it.end}</span>
              <span class="ev__name">{it.disc.name}</span>
              <span class="ev__lvl">{it.level}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
    <div class="agenda__now" data-now aria-hidden="true"><span data-now-t></span></div>
  </section>

  <section class="days wrap" aria-label="Planning par jour">
    {byDay.map(({ day, items }, di) => (
      <div class="days__d" data-day={di + 1}>
        <p class="days__name">{day}</p>
        <ul>
          {items.map((it) => (
            <li data-disc={it.disc.id}><button type="button" class="days__btn" data-disc={it.disc.id} data-day-name={day} data-time={`${it.start} – ${it.end}`} data-level={it.level} aria-haspopup="dialog"><span class="days__time">{it.start} – {it.end}</span><span>{it.disc.name}</span><span class="muted">{it.level}</span></button></li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <div class="sheet" data-sheet hidden>
    <div class="sheet__veil" data-close></div>
    <aside class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="sheet-title" data-discs={JSON.stringify(schedule.map((d) => ({ id: d.id, name: d.name, audience: d.audience, description: d.description, slots: d.slots })))}>
      <button class="sheet__close" data-close aria-label="Fermer la fiche">Fermer <span aria-hidden="true">×</span></button>
      <p class="label muted" data-s-when></p>
      <h2 class="sheet__t" id="sheet-title" data-s-name></h2>
      <p class="label" data-s-level></p>
      <p class="prose muted" data-s-desc></p>
      <div class="sheet__block">
        <p class="label muted">Public</p>
        <p class="sheet__aud" data-s-aud></p>
      </div>
      <div class="sheet__block">
        <p class="label muted">Toutes les séances</p>
        <ul class="sheet__slots" data-s-slots></ul>
      </div>
      <div class="ctas sheet__cta">
        <a href="/daleas-danse-annecy-tarifs/" class="btn">Voir les tarifs</a>
        <a href="/contact-tel/" class="tlink">S’inscrire par téléphone</a>
      </div>
    </aside>
  </div>

  <section class="discs wrap sec">
    <p class="label muted discs__h">Les disciplines</p>
    <ul class="discs__list">
      {schedule.map((d, i) => (
        <li id={d.id} data-disc={d.id}>
          <span class="label muted">{pad(i + 1)}</span>
          <span class="discs__name">{d.name}</span>
          <span class="label">{d.audience}</span>
          <span class="prose muted">{d.description}</span>
        </li>
      ))}
    </ul>
    <div class="ctas discs__cta">
      <p class="prose muted">Pas de cours pendant les vacances scolaires et les jours fériés. Cours de septembre à juin.</p>
      <a href="/daleas-danse-annecy-tarifs/" class="btn">Voir les tarifs</a>
    </div>
  </section>
</Base>

<style>
  .hh { padding-top: var(--section); }
  .hh__top + .hh__row { margin-top: 1rem; }
  .hh__top { display: flex; justify-content: space-between; gap: 1rem; }
  .hh__t {
    margin: clamp(1rem, 2vw, 2rem) 0 clamp(1.5rem, 3vw, 2.5rem) -0.06em;
    font-size: clamp(4rem, 17vw, 17rem);
    font-weight: 200;
    line-height: 0.8;
    letter-spacing: var(--tr-display);
    text-transform: uppercase;
  }
  .hh__row { display: grid; grid-template-columns: minmax(0, 26rem) minmax(0, 1fr); gap: 1.5rem clamp(2rem, 5vw, 5rem); align-items: end; padding-bottom: 1.25rem; border-bottom: 1px solid var(--ink); }
  .hh__filters { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px 18px; }
  .hf-chip {
    padding: 4px 0;
    font-size: 12px;
    letter-spacing: var(--tr-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color 0.3s var(--ease-out), background-size 0.5s var(--ease-expo);
  }
  .hf-chip:hover { color: var(--plum); }
  .hf-chip[aria-pressed='true'] { color: var(--fg); background-size: 100% 1px; }

  .agenda {
    --hh: clamp(56px, 7vh, 76px);
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem repeat(5, minmax(0, 1fr));
    column-gap: 6px;
    padding-top: 1.5rem;
    padding-bottom: var(--section);
  }
  .agenda__hours { position: relative; margin-top: 3rem; height: calc(var(--rows) * var(--hh)); }
  .agenda__hours span { position: absolute; top: calc(var(--h) * var(--hh)); left: 0; translate: 0 -50%; font-size: 11px; letter-spacing: var(--tr-caps); color: var(--fg-muted); font-variant-numeric: tabular-nums; }
  .agenda__day { height: 3rem; display: flex; align-items: flex-start; gap: 8px; font-size: 12px; letter-spacing: var(--tr-caps); text-transform: uppercase; }
  .agenda__day em { display: none; font-style: normal; color: var(--fg-muted); }
  .agenda__col.is-today .agenda__day em { display: inline; }
  .agenda__col.is-today .agenda__day span { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .agenda__track { position: relative; height: calc(var(--rows) * var(--hh)); border-left: 1px solid var(--line); }
  .agenda__col.is-today .agenda__track { background: color-mix(in srgb, var(--fg) 4%, transparent); }
  .agenda__line { position: absolute; left: 0; right: 0; top: calc(var(--h) * var(--hh)); border-top: 1px solid var(--line); }

  .ev {
    position: absolute;
    top: calc(var(--t) * var(--hh) + 2px);
    height: calc(var(--len) * var(--hh) - 4px);
    left: calc(var(--lane) * 100% / var(--lanes) + 4px);
    width: calc(100% / var(--lanes) - 6px);
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 6px 8px;
    overflow: hidden;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
    font-size: 11px;
    line-height: 1.25;
    transition: background-color 0.3s var(--ease-out), opacity 0.4s var(--ease-out), transform 0.5s var(--ease-expo);
  }
  .ev { text-align: left; cursor: pointer; }
  .ev.is-active { background: var(--plum); color: #fff; z-index: 3; }
  .ev__time { font-variant-numeric: tabular-nums; opacity: 0.7; letter-spacing: 0.02em; white-space: nowrap; }
  .ev__name { text-transform: uppercase; letter-spacing: var(--tr-caps); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .ev--short { padding-block: 4px; gap: 0; }
  .ev--short .ev__name { -webkit-line-clamp: 1; }
  .ev--short .ev__lvl { display: none; }
  .ev__lvl { opacity: 0.7; }
  .ev:hover { background: var(--plum); color: #fff; z-index: 2; transform: scale(1.03); }
  .agenda.is-filtered .ev:not(.is-on) { opacity: 0.12; }

  .agenda__now {
    position: absolute;
    left: calc(3.5rem + 6px);
    right: var(--side);
    height: 0;
    border-top: 1px solid var(--fg);
    display: none;
    pointer-events: none;
  }
  .agenda__now.is-on { display: block; }
  .agenda__now span { position: absolute; left: -3.5rem; top: 0; translate: 0 -50%; padding: 1px 4px; border-radius: 2px; background: var(--fg); color: var(--paper); font-size: 10px; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }

  .days { display: none; }
  .days__d { padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .days__d.is-today .days__name::after { content: ' — aujourd’hui'; color: var(--fg-muted); }
  .days__name { margin-bottom: 0.75rem; font-size: 1.75rem; font-weight: 300; text-transform: uppercase; letter-spacing: var(--tr-h2); }
  .days li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0 1rem; padding: 0.5rem 0; font-size: 14px; }
  .days li .muted { grid-column: 2; font-size: 13px; }
  .days__time { grid-row: span 2; font-variant-numeric: tabular-nums; }
  .days__btn { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0 1rem; width: 100%; text-align: left; text-transform: none; letter-spacing: inherit; font-size: 14px; }
  .days__btn .muted { grid-column: 2; font-size: 13px; }
  .days li { display: block; padding: 0.5rem 0; }

  .sheet { position: fixed; inset: 0; z-index: 70; }
  .sheet[hidden] { display: none; }
  .sheet__veil { position: absolute; inset: 0; background: color-mix(in srgb, var(--paper) 55%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: sh-fade 0.4s var(--ease-out); }
  .sheet__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(520px, 100%);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(5.5rem, 12vh, 7rem) clamp(1.5rem, 3vw, 2.5rem) 2rem;
    overflow-y: auto;
    background: var(--paper);
    border-left: 1px solid var(--ink);
    animation: sh-in 0.7s var(--ease-expo);
  }
  .sheet__close { align-self: flex-end; display: inline-flex; gap: 8px; align-items: center; font-size: 12px; letter-spacing: var(--tr-caps); text-transform: uppercase; }
  .sheet__close span { font-size: 18px; line-height: 1; }
  .sheet__close:hover { color: var(--plum); }
  .sheet__t { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 200; line-height: 0.95; letter-spacing: var(--tr-h1); text-transform: uppercase; }
  .sheet__block { padding-top: 1rem; border-top: 1px solid var(--line); display: grid; gap: 0.5rem; }
  .sheet__aud { font-size: 1.2rem; font-weight: 300; text-transform: uppercase; letter-spacing: var(--tr-h3); }
  .sheet__slots :global(li) { display: grid; grid-template-columns: 6.5rem 7rem 1fr; gap: 0.75rem; padding: 0.55rem 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .sheet__slots :global(li span:first-child) { text-transform: capitalize; }
  .sheet__slots :global(li.is-cur) { color: var(--plum); }
  .sheet__cta { margin-top: auto; padding-top: 1.5rem; }
  @keyframes sh-in { from { transform: translateX(100%); } }
  @keyframes sh-fade { from { opacity: 0; } }
  .days.is-filtered li:not(.is-on) { display: none; }

  .discs__h { margin-bottom: 1rem; }
  .discs__list { border-top: 1px solid var(--ink); }
  .discs__list li { display: grid; grid-template-columns: 3rem minmax(0, 1.1fr) minmax(0, 0.6fr) minmax(0, 1.3fr); gap: 0.5rem 1.5rem; align-items: baseline; padding: 1.1rem 0; border-bottom: 1px solid var(--line); scroll-margin-top: 8rem; }
  .discs__name { font-size: clamp(1.4rem, 2.4vw, 2.2rem); font-weight: 300; line-height: 1.05; letter-spacing: var(--tr-h2); text-transform: uppercase; }
  .discs__list li:target { background: color-mix(in srgb, var(--fg) 5%, transparent); }
  .discs__cta { justify-content: space-between; margin-top: 2.5rem; }

  @media (max-width: 900px) {
    .hh__row { grid-template-columns: 1fr; }
    .hh__filters { justify-content: flex-start; }
    .agenda { display: none; }
    .days { display: block; padding-top: 1rem; }
    .discs__list li { grid-template-columns: 2.5rem 1fr; }
    .discs__list li > :nth-child(n + 3) { grid-column: 2; }
  }
</style>

<script>
  const agenda = document.querySelector<HTMLElement>('[data-agenda]')!;
  const daysList = document.querySelector<HTMLElement>('.days')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.hf-chip')];
  const setFilter = (f: string) => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === f)));
    [agenda, daysList].forEach((root) => {
      root.classList.toggle('is-filtered', f !== 'all');
      root.querySelectorAll<HTMLElement>('[data-disc]').forEach((el) => el.classList.toggle('is-on', el.dataset.disc === f));
    });
  };
  chips.forEach((c) => c.addEventListener('click', () => setFilter(c.dataset.filter!)));
  const sheet = document.querySelector<HTMLElement>('[data-sheet]')!;
  const panel = sheet.querySelector<HTMLElement>('.sheet__panel')!;
  const discs = JSON.parse(panel.dataset.discs || '[]');
  const $ = (k: string) => sheet.querySelector<HTMLElement>(`[data-s-${k}]`)!;
  let opener: HTMLElement | null = null;
  const open = (btn: HTMLElement) => {
    const d = discs.find((x: { id: string }) => x.id === btn.dataset.disc);
    if (!d) return;
    opener = btn;
    $('when').textContent = `${btn.dataset.dayName} — ${btn.dataset.time}`;
    $('name').textContent = d.name;
    $('level').textContent = btn.dataset.level || '';
    $('desc').textContent = d.description;
    $('aud').textContent = d.audience;
    $('slots').innerHTML = '';
    d.slots.forEach((sl: { day: string; start: string; end: string; level: string }) => {
      const li = document.createElement('li');
      if (sl.day === btn.dataset.dayName && `${sl.start} – ${sl.end}` === btn.dataset.time) li.className = 'is-cur';
      [sl.day, `${sl.start} – ${sl.end}`, sl.level].forEach((v) => { const sp = document.createElement('span'); sp.textContent = v; li.append(sp); });
      $('slots').append(li);
    });
    agenda.querySelectorAll('.ev').forEach((e) => e.classList.toggle('is-active', e === btn));
    setFilter(d.id);
    sheet.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    sheet.querySelector<HTMLElement>('.sheet__close')!.focus({ preventScroll: true });
  };
  const close = () => {
    if (sheet.hidden) return;
    sheet.hidden = true;
    document.documentElement.style.overflow = '';
    agenda.querySelectorAll('.ev').forEach((e) => e.classList.remove('is-active'));
    setFilter('all');
    opener?.focus({ preventScroll: true });
  };
  document.querySelectorAll<HTMLElement>('.ev, .days__btn').forEach((b) => b.addEventListener('click', () => open(b)));
  sheet.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  const hash = location.hash.slice(1);
  if (hash && chips.some((c) => c.dataset.filter === hash)) setFilter(hash);

  const parts = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris', hour12: false }).formatToParts(new Date());
  const get = (t: string) => parts.find((p) => p.type === t)?.value || '';
  const order = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi'];
  const dIdx = order.indexOf(get('weekday').toLowerCase()) + 1;
  if (dIdx > 0) {
    document.querySelectorAll(`[data-day="${dIdx}"]`).forEach((el) => el.classList.add('is-today'));
    const label = document.querySelector('[data-today-label]');
    if (label) label.textContent = `Aujourd’hui : ${get('weekday')}`;
    const mins = Number(get('hour')) * 60 + Number(get('minute'));
    const now = document.querySelector<HTMLElement>('[data-now]')!;
    if (mins >= 12 * 60 && mins <= 22 * 60) {
      const track = agenda.querySelector<HTMLElement>('.agenda__track')!;
      const place = () => {
        const top = track.offsetTop + ((mins - 720) / 60) * (track.offsetHeight / 10);
        now.style.top = `${top}px`;
      };
      now.querySelector('[data-now-t]')!.textContent = `${get('hour')}h${get('minute')}`;
      now.classList.add('is-on');
      place();
      addEventListener('resize', place);
    }
  }
</script>
