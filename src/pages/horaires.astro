---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { schedule, days, season } from '../data/site';
import jazz from '../assets/img/coursdansemodernjazz_daleasdanseannecy.jpg';

const toMin = (t: string) => {
  const [h, m] = t.split('h').map(Number);
  return h * 60 + (m || 0);
};
const byDay = days.map((day) => ({
  day,
  items: schedule
    .flatMap((d) => d.slots.filter((s) => s.day === day).map((s) => ({ ...s, disc: d })))
    .sort((a, b) => toMin(a.start) - toMin(b.start)),
}));
const total = schedule.reduce((n, d) => n + d.slots.length, 0);
---
<Base
  title="Horaires des cours"
  description={`Horaires ${season} des cours de danse Daléas à Annecy : éveil rythmique, initiation jazz, jazz ados et adultes, moderne, classe chorégraphique.`}
>
  <PageHero kicker={`Planning ${season}`} accent="cours réguliers" image={jazz} pos="50% 45%">
    Horaires<br /><em>{total} cours par semaine</em>
    <Fragment slot="sub">De l’éveil rythmique dès 2 ans ½ jusqu’aux classes avancées.</Fragment>
  </PageHero>

  <section class="planning wrap" data-planning>
    <div class="controls" data-reveal>
      <div class="controls__group" role="tablist" aria-label="Affichage">
        <button class="chip" role="tab" aria-selected="true" data-view="disc">Par cours</button>
        <button class="chip" role="tab" aria-selected="false" data-view="day">Par jour</button>
      </div>
      <span class="controls__sep" aria-hidden="true"></span>
      <div class="controls__group" role="group" aria-label="Filtrer par discipline">
        <button class="chip" aria-pressed="true" data-filter="all">Tous</button>
        {schedule.map((d) => <button class="chip" aria-pressed="false" data-filter={d.id}>{d.name}</button>)}
      </div>
    </div>

    <div data-panel="disc">
      {schedule.map((d, i) => (
        <article class="disc" id={d.id} data-disc={d.id}>
          <header class="disc__head">
            <p class="label muted">{String(i + 1).padStart(2, '0')} — {d.audience}</p>
            <h2 class="h2 disc__name">{d.name}</h2>
            <p class="prose muted disc__desc">{d.description}</p>
          </header>
          <ul class="rows slots">
            {d.slots.map((s) => (
              <li>
                <span class="label">{s.level}</span>
                <span class="slots__day">{s.day}</span>
                <span class="slots__time">{s.start} – {s.end}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="week" data-panel="day" hidden>
      {byDay.map(({ day, items }) => (
        <div class="week__col">
          <h2 class="label week__day">{day}</h2>
          <ul>
            {items.map((it) => (
              <li class="cell" data-disc={it.disc.id}>
                <span class="cell__time">{it.start} – {it.end}</span>
                <span class="label">{it.disc.name}</span>
                <span class="label muted">{it.level}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="notes">
      <p class="prose muted">Pas de cours pendant les vacances scolaires et les jours fériés.<br />Cours dispensés de septembre à juin.</p>
      <div class="ctas">
        <a href="/daleas-danse-annecy-tarifs/" class="btn">Voir les tarifs</a>
        <a href="/contact-tel/" class="tlink">Une question</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .planning { padding-bottom: var(--section); }
  .controls {
    position: sticky;
    top: 88px;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
    padding: 6px;
    border-radius: 28px;
    background: color-mix(in srgb, var(--white) 72%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 40px -28px rgba(20, 22, 23, 0.45);
  }
  .controls__group { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .controls__sep { width: 1px; height: 22px; background: var(--line); }
  .controls .chip { border-radius: 999px; background: transparent; padding: 9px 14px; transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out); }
  .controls .chip[aria-selected='true'], .controls .chip[aria-pressed='true'] { background: var(--ink); color: var(--white); }

  [data-disc].is-off { display: none; }

  .disc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    scroll-margin-top: 10rem;
    animation: fade 0.7s var(--ease-out) both;
  }
  .disc + .disc { border-top: 1px solid var(--line); }
  .disc__head { display: flex; flex-direction: column; gap: 0.9rem; }
  .disc__name { margin: 0; }
  .disc__desc { max-width: 24rem; }
  .slots { --rc: minmax(0, 1.3fr) minmax(0, 0.7fr) minmax(0, 0.9fr); }
  .slots__day, .slots__time { font-size: 17px; font-weight: 300; text-transform: uppercase; letter-spacing: var(--tr-caps-l); }
  .slots__time { text-align: right; font-variant-numeric: tabular-nums; }

  .week { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .week[hidden] { display: none; }
  .week__day { margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--ink); }
  .week ul { display: grid; gap: 6px; }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px;
    border-radius: 6px;
    background: var(--surface);
    animation: fade 0.6s var(--ease-out) both;
  }
  .cell__time { font-size: 17px; font-weight: 300; margin-bottom: 6px; font-variant-numeric: tabular-nums; }

  @keyframes fade { from { opacity: 0; transform: translateY(8px); } }

  .notes { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem 3rem; margin-top: clamp(3rem, 6vw, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--ink); }

  @media (max-width: 1000px) {
    .week { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 2.5rem; }
  }
  @media (max-width: 700px) {
    .controls { position: static; border-radius: 18px; }
    .controls__sep { display: none; }
    .disc { grid-template-columns: 1fr; }
    .slots { --rc: 1fr auto; }
    .slots li .label { grid-column: 1 / -1; }
    .week { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .slots > li { grid-template-columns: 1fr auto; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-planning]')!;
  const tabs = root.querySelectorAll<HTMLButtonElement>('[data-view]');
  const chips = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const panels = root.querySelectorAll<HTMLElement>('[data-panel]');

  const setView = (v: string) => {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.view === v)));
    panels.forEach((p) => (p.hidden = p.dataset.panel !== v));
  };
  const setFilter = (f: string) => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === f)));
    root.querySelectorAll<HTMLElement>('[data-disc]').forEach((el) => {
      el.classList.toggle('is-off', f !== 'all' && el.dataset.disc !== f);
    });
  };
  tabs.forEach((t) => t.addEventListener('click', () => setView(t.dataset.view!)));
  chips.forEach((c) => c.addEventListener('click', () => setFilter(c.dataset.filter!)));

  const hash = location.hash.slice(1);
  if (hash && root.querySelector(`[data-filter="${CSS.escape(hash)}"]`)) setFilter(hash);
</script>
