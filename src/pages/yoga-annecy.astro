---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import yoga from '../assets/img/coursyogaannecy-marysedaleas.jpg';

const path = [
  ['Europe', 'Deux ans de travail et de pratique.'],
  ['Rishikesh', 'Perfectionnement au centre Sivananda.'],
  ['Méthode Desikachar', 'Quatre ans auprès de Claude Maréchal, jusqu’à l’autorisation de transmettre.'],
  ['1967', 'Premiers cours de Viniyoga.'],
];
---
<Base
  title="Cours de yoga à Annecy"
  description="Maryse Daléas enseigne le Viniyoga depuis 1967 et continue de partager son savoir dans ses cours dispensés à l’Espace Daléas d’Annecy."
>
  <PageHero kicker="Viniyoga avec" accent="Maryse Daléas" image={yoga} pos="50% 35%">
    Yoga<br /><em>le corps, le souffle</em>
    <Fragment slot="sub">Séances le matin, à midi, l’après-midi ou le soir, à l’Espace Daléas.</Fragment>
  </PageHero>

  <section class="wrap sec">
    <SectionHead n="01" label="La pratique">Trouver<br /><em>un bon contrôle de soi</em></SectionHead>
    <div class="cols">
      <p class="lead" data-reveal>
        Le yoga est un ensemble de techniques qui, par un travail sur le corps, sur le souffle et sur la pensée,
        avec l’aide de la relaxation, permet de trouver un bon contrôle de soi.
      </p>
      <p class="prose muted" data-reveal style="--d:.1s">
        Un état de bien-être, ou tout simplement une meilleure santé. Jeunes, moins jeunes, souples ou raides :
        venez participer à une séance.
      </p>
    </div>
  </section>

  <section class="on-black sec stage">
    <div class="wrap">
      <SectionHead n="02" label="Parcours">Maryse Daléas,<br /><em>depuis 1967</em></SectionHead>
      <ul class="rows path" data-reveal>
        {path.map(([k, v], i) => (
          <li>
            <span class="label muted">{String(i + 1).padStart(2, '0')}</span>
            <span class="rows__big">{k}</span>
            <span class="prose muted">{v}</span>
          </li>
        ))}
      </ul>
      <div class="ctas path__cta" data-reveal>
        <a href={site.links.yoga} class="btn" target="_blank" rel="noopener">Horaires & infos yoga</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .path__cta { margin-top: clamp(3rem, 6vw, 5rem); }
</style>
