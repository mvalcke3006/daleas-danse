---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { site, sms } from '../data/site';
import studio from '../assets/img/espacedaleas-salle1.jpg';

const features = [
  ['3 studios', 'Pour activités artistiques et de bien-être, yoga, répétitions.'],
  ['Un grand vestiaire', 'Avec douches et toutes les commodités nécessaires.'],
  ['À l’heure ou au week-end', 'Location hebdomadaire ou ponctuelle, stages de week-end selon disponibilités.'],
];
---
<Base
  title="Location de salles"
  description="L’Espace Daléas propose ses 3 studios à la location, en plein centre d’Annecy, pour les professeurs de disciplines artistiques et bien-être ainsi que les répétitions."
>
  <PageHero kicker="Espace Daléas" accent="location de salles" image={studio} pos="50% 50%">
    Location<br /><em>trois studios à Annecy</em>
    <Fragment slot="sub">Pour les professeurs de disciplines artistiques et de bien-être, et pour vos répétitions.</Fragment>
  </PageHero>


  <section class="wrap sec">
    <SectionHead n="01" label="L’espace">Au cœur<br /><em>d’Annecy</em>
      <Fragment slot="aside">{site.address.venue}, {site.address.street}, {site.address.zip} {site.address.city}.</Fragment>
    </SectionHead>
    <ul class="cols" style="--n:3">
      {features.map(([k, v], i) => (
        <li class="card on-paper lit feat" data-reveal style={`--d:${i * 0.06}s`}>
          <p class="label muted">{String(i + 1).padStart(2, '0')}</p>
          <p class="h3 feat__k">{k}</p>
          <p class="prose muted">{v}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="on-black sec stage">
    <div class="wrap">
      <SectionHead n="02" label="Réserver">Par écrit,<br /><em>tout simplement</em>
        <Fragment slot="aside">Précisez l’activité, les créneaux et la fréquence souhaités.</Fragment>
      </SectionHead>
      <div class="ctas" data-reveal>
        <a href={sms(site.rentalPhone)} class="btn">SMS — {site.rentalPhone}</a>
        <a href={`mailto:${site.email}?subject=Location%20de%20salle`} class="tlink">E-mail</a>
        <a href={site.links.espace} class="tlink" target="_blank" rel="noopener">espacedaleas.fr</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .feat { min-height: clamp(220px, 28vh, 300px); }
  .feat__k { margin-top: auto; }
</style>
