---
import Base from '../layouts/Base.astro';
import FloatHero from '../components/FloatHero.astro';
import sp1 from '../assets/img/spectacle-1.jpg';
import sp2 from '../assets/img/spectacle-2.jpg';
import sp3 from '../assets/img/spectacle-3.jpg';
import sp5 from '../assets/img/spectacle-5.jpg';
import gala from '../assets/img/daleasdanse-slide4.jpg';
import kids from '../assets/img/coursinitiationjazz_daleasdanse.jpg';
import {
  season, membership, kidsPricing, mainPricing, unlimited, singleClass, card10, pricingRules,
} from '../data/site';

const data = {
  kids: { periods: kidsPricing.periods, rows: kidsPricing.rows },
  main: { periods: mainPricing.periods, rows: mainPricing.rows },
};
const extras = [
  { k: 'Cours à l’unité', v: singleClass, note: 'Sans engagement' },
  { k: 'Carte 10 cours', v: card10.price, note: `Valable ${card10.validity}` },
  { k: 'Forfait illimité', v: unlimited, note: 'Tous les cours, toute l’année' },
];
const first = mainPricing.rows[0];
---
<Base
  title="Tarifs"
  description={`Tarifs ${season} de l’école Daléas Danse à Annecy : forfaits trimestriels et annuels, carte 10 cours, cours à l’unité, forfait illimité.`}
  image="/og/tarifs.jpg"
>
  <FloatHero
    variant="bars"
    title="Tarifs"
    accent="à votre rythme"
    left={`Saison ${season}`}
    right="Du cours à l’unité à l’illimité"
    photos={[
      { src: sp1, d: 0.2, pos: '50% 40%', label: 'le cours', value: 18 },
      { src: sp2, d: 0.4, pos: '50% 45%', label: 'carte 10 cours', value: 160 },
      { src: sp3, d: 0.6, pos: '50% 50%', label: '1 cours / an', value: 370 },
      { src: sp5, d: 0.8, pos: '45% 60%', label: '2 cours / an', value: 630 },
      { src: gala, d: 1, pos: '50% 40%', label: 'illimité', value: 995 },
    ]}
  />

  <section class="calc wrap" data-calc data-prices={JSON.stringify(data)}>
    <div class="calc__top">
      <p class="label muted">Tarifs {season}</p>
      <p class="label muted">Calculer son forfait</p>
    </div>

    <p class="calc__phrase">
      <span class="calc__line">
        <span>Je danse</span>
        <span class="calc__opts" role="radiogroup" aria-label="Âge">
          <button role="radio" aria-checked="false" data-k="who" data-v="kids">enfant</button>
          <span class="calc__or">/</span>
          <button role="radio" aria-checked="true" data-k="who" data-v="main">dès 8 ans</button>
        </span>
      </span>
      <span class="calc__line">
        <span class="calc__opts" role="radiogroup" aria-label="Cours par semaine">
          <button role="radio" aria-checked="true" data-k="n" data-v="0">1</button>
          <span class="calc__or">/</span>
          <button role="radio" aria-checked="false" data-k="n" data-v="1">2</button>
          <span class="calc__or">/</span>
          <button role="radio" aria-checked="false" data-k="n" data-v="2">3</button>
        </span>
        <span>cours par semaine</span>
      </span>
      <span class="calc__line">
        <span>réglé</span>
        <span class="calc__opts" role="radiogroup" aria-label="Paiement">
          <button role="radio" aria-checked="true" data-k="pay" data-v="year">à l’année</button>
          <span class="calc__or">/</span>
          <button role="radio" aria-checked="false" data-k="pay" data-v="term">au trimestre</button>
        </span>
      </span>
    </p>

    <div class="calc__out" aria-live="polite">
      <p class="calc__price"><span data-price>{first.year}</span><small>€</small></p>
      <div class="calc__detail">
        <p class="label" data-unit>Pour l’année</p>
        <p class="prose muted" data-split>{mainPricing.periods.map((p, i) => `${p} : ${first.prices[i]} €`).join(' · ')}</p>
        <p class="prose muted">+ adhésion annuelle : {membership.map((m) => `${m.price} € ${m.label.toLowerCase()}`).join(', ')}</p>
      </div>
    </div>
  </section>

  <section class="free wrap sec">
    <p class="label muted free__h">Sans engagement, ou sans limite</p>
    <ul class="free__list">
      {extras.map((e, i) => (
        <li data-reveal style={`--d:${i * 0.06}s`}>
          <span class="label muted">{e.k}</span>
          <span class="free__v">{e.v}<small>€</small></span>
          <span class="label muted">{e.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="rules on-black sec stage">
    <div class="wrap rules__grid">
      <p class="rules__t">Règlement</p>
      <div class="rules__c">
        <p class="label rules__h">Forfait trimestriel</p>
        {pricingRules.quarterly.map((r) => <p class="prose">{r}</p>)}
        <p class="label rules__h">Bon à savoir</p>
        {pricingRules.general.map((r) => <p class="prose">{r}</p>)}
      </div>
      <div class="rules__c">
        <p class="label rules__h">Forfait annuel</p>
        {pricingRules.yearly.map((r) => <p class="prose">{r}</p>)}
        <p class="label rules__h">Réduction</p>
        <p class="prose">{pricingRules.discount}</p>
      </div>
      <div class="ctas rules__cta">
        <a href="/horaires/" class="btn">Choisir un cours</a>
        <a href="/contact-tel/" class="tlink">Poser une question</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .calc { display: flex; flex-direction: column; padding-top: var(--section); padding-bottom: clamp(2rem, 5vh, 4rem); }
  .calc__top { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--ink); }
  .calc__phrase {
    display: grid;
    gap: 0.04em;
    margin-top: clamp(2rem, 5vh, 3.5rem);
    font-size: clamp(2rem, 4.8vw, 4.6rem);
    font-weight: 200;
    line-height: 1.12;
    letter-spacing: var(--tr-h1);
    text-transform: uppercase;
  }
  .calc__line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.32em; }
  .calc__opts { display: inline-flex; align-items: baseline; gap: 0.2em; }
  .calc__or { color: var(--fg-muted); font-weight: 200; }
  .calc__opts button {
    font-weight: 200;
    text-transform: uppercase;
    letter-spacing: inherit;
    color: color-mix(in srgb, var(--fg) 28%, transparent);
    background: linear-gradient(currentColor, currentColor) 0 92% / 0 2px no-repeat;
    transition: color 0.35s var(--ease-out), background-size 0.6s var(--ease-expo);
  }
  .calc__opts button:hover { color: var(--plum); }
  .calc__opts button[aria-checked='true'] { color: var(--fg); background-size: 100% 2px; }
  .calc__opts button:disabled { opacity: 0.25; cursor: not-allowed; }

  .calc__out { margin-top: auto; display: grid; grid-template-columns: auto minmax(0, 24rem); align-items: end; gap: 1.5rem clamp(2rem, 5vw, 5rem); padding-top: 2rem; }
  .calc__price {
    display: flex;
    align-items: flex-start;
    font-size: clamp(6rem, 22vw, 22rem);
    font-weight: 200;
    line-height: 0.78;
    letter-spacing: var(--tr-display);
    font-variant-numeric: tabular-nums;
    margin-left: -0.05em;
  }
  .calc__price small { font-size: 0.24em; margin: 0.2em 0 0 0.1em; }
  .calc__price span { display: inline-block; transition: filter 0.4s var(--ease-out), opacity 0.4s var(--ease-out); }
  .calc__price.is-swap span { filter: blur(10px); opacity: 0.2; }
  .calc__detail { display: grid; gap: 0.6rem; padding-bottom: 0.6rem; }

  .free__h { margin-bottom: 1rem; }
  .free__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .free__list li { display: grid; gap: 0.75rem; padding: 1.25rem clamp(1rem, 2vw, 2rem) 0 0; }
  .free__list li + li { padding-left: clamp(1rem, 2vw, 2rem); border-left: 1px solid var(--line); }
  .free__v { font-size: clamp(3.6rem, 8vw, 7.5rem); font-weight: 200; line-height: 0.9; letter-spacing: var(--tr-display); font-variant-numeric: tabular-nums; }
  .free__v small { font-size: 0.3em; margin-left: 0.08em; vertical-align: 1.6em; }

  .rules__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr); gap: 2rem clamp(1.5rem, 4vw, 4rem); }
  .rules__t { font-size: clamp(2.6rem, 6vw, 5.5rem); font-weight: 200; line-height: 0.9; letter-spacing: var(--tr-display); text-transform: uppercase; }
  .rules__h { margin: 2rem 0 0.8rem; }
  .rules__c > .rules__h:first-child { margin-top: 0; }
  .rules .prose { margin-bottom: 0.6rem; color: var(--fg-muted); }
  .rules__cta { grid-column: 2 / -1; margin-top: 1.5rem; }

  @media (max-width: 900px) {
    .calc__out { grid-template-columns: 1fr; }
    .free__list { grid-template-columns: 1fr; }
    .free__list li { padding: 1.25rem 0; }
    .free__list li + li { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .rules__grid { grid-template-columns: 1fr; }
    .rules__cta { grid-column: 1; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-calc]')!;
  const prices = JSON.parse(root.dataset.prices || '{}');
  const state: Record<string, string> = { who: 'main', n: '0', pay: 'year' };
  const btns = [...root.querySelectorAll<HTMLButtonElement>('button[data-k]')];
  const out = root.querySelector<HTMLElement>('.calc__price')!;
  const priceEl = root.querySelector<HTMLElement>('[data-price]')!;
  const unitEl = root.querySelector<HTMLElement>('[data-unit]')!;
  const splitEl = root.querySelector<HTMLElement>('[data-split]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let shown = Number(priceEl.textContent);

  const tween = (to: number) => {
    if (reduce) { priceEl.textContent = String(to); shown = to; return; }
    const from = shown, t0 = performance.now();
    const step = (t: number) => {
      const p = Math.min(1, (t - t0) / 700);
      const v = Math.round(from + (to - from) * (1 - Math.pow(1 - p, 4)));
      priceEl.textContent = String(v);
      if (p < 1) requestAnimationFrame(step); else shown = to;
    };
    requestAnimationFrame(step);
  };

  const render = () => {
    const set = prices[state.who];
    if (state.who === 'kids') state.n = '0';
    btns.forEach((b) => {
      b.setAttribute('aria-checked', String(state[b.dataset.k!] === b.dataset.v));
      if (b.dataset.k === 'n') b.disabled = state.who === 'kids' && b.dataset.v !== '0';
    });
    const row = set.rows[Number(state.n)] || set.rows[0];
    const term = Math.max(...row.prices);
    const value = state.pay === 'year' ? row.year : term;
    unitEl.textContent = state.pay === 'year' ? 'Pour l’année' : 'Par trimestre, au plus';
    splitEl.textContent = set.periods.map((p: string, i: number) => `${p} : ${row.prices[i]} €`).join(' · ');
    out.classList.add('is-swap');
    setTimeout(() => out.classList.remove('is-swap'), 180);
    tween(value);
  };
  btns.forEach((b) => b.addEventListener('click', () => { state[b.dataset.k!] = b.dataset.v!; render(); }));
</script>
