---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import {
  season, membership, kidsPricing, mainPricing, unlimited, singleClass, card10, pricingRules,
} from '../data/site';

const tables = [kidsPricing, mainPricing];
const extras = [
  { k: 'Cours à l’unité', v: singleClass, note: 'Sans engagement' },
  { k: 'Carte 10 cours', v: card10.price, note: `Valable ${card10.validity}` },
  { k: 'Forfait illimité', v: unlimited, note: '+ adhésion annuelle' },
];
---
<Base
  title="Tarifs"
  description={`Tarifs ${season} de l’école Daléas Danse à Annecy : forfaits trimestriels et annuels, carte 10 cours, cours à l’unité, forfait illimité.`}
>
  <PageHero kicker={`Saison ${season}`} accent="tarifs et inscriptions">
    Tarifs<br /><em>à votre rythme</em>
    <Fragment slot="sub">
      Adhésion annuelle : {membership.map((m, i) => <>{i > 0 && ' — '}{m.price} € {m.label.toLowerCase()}</>)}
    </Fragment>
  </PageHero>

  {tables.map((t, ti) => (
    <section class="wrap sec sec--tight tbl">
      <SectionHead n={String(ti + 1).padStart(2, '0')} label={t.audience}>{t.title}</SectionHead>
      <table data-reveal>
        <caption class="sr-only">Tarifs {t.title}, par trimestre et à l’année</caption>
        <thead>
          <tr class="label">
            <th scope="col"><span class="sr-only">Formule</span></th>
            {t.periods.map((p) => <th scope="col">{p}</th>)}
            <th scope="col">Année</th>
          </tr>
        </thead>
        <tbody>
          {t.rows.map((r) => (
            <tr>
              <th scope="row" class="label">{r.label}</th>
              {r.prices.map((p, i) => <td data-label={t.periods[i]}>{p} €</td>)}
              <td data-label="Année" class="year"><span>{r.year} €</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <section class="wrap sec sec--tight">
    <SectionHead n="03" label="Formules libres">Sans engagement,<br /><em>ou sans limite</em></SectionHead>
    <ul class="cols extras" style="--n:3">
      {extras.map((e, i) => (
        <li class={`card ${i === 2 ? 'on-black' : 'on-paper'} lit`} data-reveal style={`--d:${i * 0.06}s`}>
          <p class="label muted">{e.k}</p>
          <p class="card__num xl">{e.v}<small>€</small></p>
          <p class="label muted">{e.note}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="on-black sec stage">
    <div class="wrap">
      <SectionHead n="04" label="Règlement">Modalités</SectionHead>
      <div class="cols rules">
        <div data-reveal>
          <p class="label rules__h">Forfait trimestriel</p>
          {pricingRules.quarterly.map((r) => <p class="prose">{r}</p>)}
          <p class="label rules__h">Bon à savoir</p>
          {pricingRules.general.map((r) => <p class="prose">{r}</p>)}
        </div>
        <div data-reveal style="--d:.1s">
          <p class="label rules__h">Forfait annuel</p>
          {pricingRules.yearly.map((r) => <p class="prose">{r}</p>)}
          <p class="label rules__h">Réduction</p>
          <p class="prose">{pricingRules.discount}</p>
        </div>
      </div>
      <div class="ctas rules__cta" data-reveal>
        <a href="/horaires/" class="btn">Choisir un cours</a>
        <a href="/contact-tel/" class="tlink">Poser une question</a>
      </div>
    </div>
  </section>
</Base>

<style>
  table { width: 100%; border-collapse: collapse; border-top: 1px solid var(--ink); }
  th, td { text-align: right; padding: 1.1rem 0.5rem; border-bottom: 1px solid var(--line); font-weight: inherit; }
  thead th { color: var(--muted); }
  tbody th { text-align: left; padding-left: 0; }
  td { font-size: clamp(18px, 1.6vw, 22px); font-weight: 300; font-variant-numeric: tabular-nums; }
  .year span { display: inline-block; padding: 6px 12px; border-radius: 999px; background: var(--ink); color: var(--white); font-weight: 400; }

  .extras .card { min-height: clamp(240px, 30vh, 320px); }
  .card__num small { font-size: 0.4em; margin-left: 0.1em; vertical-align: 0.9em; }

  .rules .prose { margin-bottom: 0.7rem; color: var(--fg-muted); }
  .rules__h { margin: 2.25rem 0 0.9rem; }
  .rules > div > .rules__h:first-child { margin-top: 0; }
  .rules__cta { margin-top: clamp(3rem, 6vw, 5rem); }

  @media (max-width: 700px) {
    thead { display: none; }
    table, tbody, tr, th, td { display: block; }
    tbody tr { padding: 1rem 0; border-bottom: 1px solid var(--line); }
    tbody th { padding: 0 0 0.5rem; border: 0; }
    td { display: flex; justify-content: space-between; align-items: baseline; padding: 0.4rem 0; border: 0; }
    td::before { content: attr(data-label); font-size: 12px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  }
</style>
