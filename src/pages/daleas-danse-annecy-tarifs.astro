---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import {
  season, membership, kidsPricing, mainPricing, unlimited, singleClass, card10, pricingRules,
} from '../data/site';

const tables = [kidsPricing, mainPricing];
const extras = [
  { k: 'Cours à l’unité', v: singleClass, note: 'Sans engagement' },
  { k: 'Carte 10 cours', v: card10.price, note: `Valable ${card10.validity}` },
  { k: 'Forfait illimité', v: unlimited, note: '+ adhésion annuelle' },
];
---
<Base
  title="Tarifs"
  description={`Tarifs ${season} de l’école Daléas Danse à Annecy : forfaits trimestriels et annuels, carte 10 cours, cours à l’unité, forfait illimité.`}
>
  <PageHero kicker={`Saison ${season}`} accent="tarifs et inscriptions">
    Tarifs<br /><em>à votre rythme</em>
    <Fragment slot="sub">
      Adhésion annuelle : {membership.map((m, i) => <>{i > 0 && ' — '}{m.price} € {m.label.toLowerCase()}</>)}
    </Fragment>
  </PageHero>

  <section class="wrap">
    {tables.map((t) => (
      <div class="tbl" data-reveal>
        <div class="tbl__head">
          <h2 class="tbl__title display">{t.title}</h2>
          <p class="label grey">{t.audience}</p>
        </div>
        <table>
          <caption class="sr-only">Tarifs {t.title}, par trimestre et à l’année</caption>
          <thead>
            <tr class="label">
              <th scope="col"><span class="sr-only">Formule</span></th>
              {t.periods.map((p) => <th scope="col">{p}</th>)}
              <th scope="col">Année</th>
            </tr>
          </thead>
          <tbody>
            {t.rows.map((r) => (
              <tr>
                <th scope="row" class="label">{r.label}</th>
                {r.prices.map((p, i) => <td data-label={t.periods[i]}>{p} €</td>)}
                <td data-label="Année" class="year"><span class="chip">{r.year} €</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}

    <ul class="extras">
      {extras.map((e, i) => (
        <li data-reveal style={`--d:${i * 0.06}s`}>
          <p class="label">{e.k}</p>
          <p class="extras__v display">{e.v} €</p>
          <p class="label grey">{e.note}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="rules">
    <div class="chapter-head" data-reveal><p class="label">Règlement</p><p class="num">§</p><h2 class="label">Modalités</h2></div>
    <div class="rules__cols">
      <div class="rules__l" data-reveal>
        <p class="label">Forfait trimestriel</p>
        {pricingRules.quarterly.map((r) => <p class="prose">{r}</p>)}
        <p class="label rules__gap">Bon à savoir</p>
        {pricingRules.general.map((r) => <p class="prose">{r}</p>)}
      </div>
      <div class="rules__r" data-reveal style="--d:.1s">
        <p class="label">Forfait annuel</p>
        {pricingRules.yearly.map((r) => <p class="prose">{r}</p>)}
        <p class="label rules__gap">Réduction</p>
        <p class="prose">{pricingRules.discount}</p>
      </div>
    </div>
    <div class="rules__cta" data-reveal>
      <a href="/horaires/" class="btn">Choisir un cours</a>
      <a href="/contact-tel/" class="btn btn--ghost">Poser une question</a>
    </div>
  </section>
</Base>

<style>
  .wrap { max-width: 1100px; margin-inline: auto; padding-inline: var(--side); }
  .tbl { padding: 3rem 0; border-top: 1px solid var(--hair); }
  .tbl__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 2rem; }
  .tbl__title { font-size: clamp(2rem, 3.4vw, 3rem); font-weight: 320; letter-spacing: -0.025em; line-height: 1; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: right; padding: 0.9rem 0.5rem; border-bottom: 1px solid var(--hair); font-weight: inherit; }
  thead th { color: var(--grey); padding-top: 0; }
  tbody th { text-align: left; }
  tbody tr:last-child > * { border-bottom: 0; }
  td { font-family: var(--display); font-size: 20px; font-variant-numeric: tabular-nums; }
  .year .chip { font-family: var(--display); font-size: 18px; line-height: 1.1; background: var(--black); color: var(--white); }

  .extras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    margin: 3rem 0 0;
  }
  .extras li { padding: 14px; border-radius: 4px; background: var(--chip); display: flex; flex-direction: column; gap: 4px; }
  .extras__v { font-size: clamp(2.6rem, 4.4vw, 3.8rem); font-weight: 300; letter-spacing: -0.03em; line-height: 1; margin: 2.5rem 0 0.4rem; }

  .rules { padding: clamp(8rem, 14vw, 11rem) 1rem 2rem; }
  .rules__cols {
    display: grid;
    grid-template-columns: 1fr clamp(80px, 10vw, 150px) 1fr;
    margin-top: 5rem;
  }
  .rules__l { grid-column: 1; justify-self: end; max-width: 19rem; text-align: right; }
  .rules__r { grid-column: 3; max-width: 19rem; margin-top: 7rem; }
  .rules .label { margin-bottom: 0.8rem; }
  .rules .prose { margin-bottom: 0.7rem; }
  .rules__gap { margin-top: 2.5rem; }
  .rules__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 6rem; }

  @media (max-width: 700px) {
    thead { display: none; }
    table, tbody, tr, th, td { display: block; }
    tbody tr { padding: 1rem 0; border-bottom: 1px solid var(--hair); }
    tbody th { padding: 0 0 0.5rem; border: 0; }
    td { display: flex; justify-content: space-between; align-items: baseline; padding: 0.4rem 0; border: 0; font-size: 18px; }
    td::before { content: attr(data-label); font-family: var(--text); font-size: 12px; color: var(--grey); }
    .extras { grid-template-columns: 1fr; }
    .rules__cols { grid-template-columns: 1fr; gap: 3rem; }
    .rules__l, .rules__r { grid-column: 1; justify-self: start; text-align: left; margin-top: 0; }
  }
</style>
