---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." footer={false}>
  <section class="nf wrap">
    <p class="label muted">Erreur 404</p>
    <h1 class="nf__t xl" data-reveal>Faux pas</h1>
    <p class="prose muted">Cette page n’existe pas ou a été déplacée.</p>
    <a href="/" class="btn">Retour à l’accueil</a>
  </section>
</Base>

<style>
  .nf { min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem; text-align: center; }
  .nf__t { font-size: clamp(4.5rem, 16vw, 14rem); }
</style>
