---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroFloat from '../components/HeroFloat.astro';
import IndexList from '../components/IndexList.astro';
import { announcement, schedule, weekends, singleClass, ages } from '../data/site';

import yoga from '../assets/img/coursyogaannecy-marysedaleas.jpg';
import studio from '../assets/img/espacedaleas-salle1.jpg';
import gala from '../assets/img/daleasdanse-slide4.jpg';
import team from '../assets/img/daleasdanse-contactdianeetdelphine.jpg';
import eveil from '../assets/img/cours-eveil.jpg';
import studioClass from '../assets/img/cours-studio-nb.jpg';
import sp2 from '../assets/img/spectacle-2.jpg';
import sp5 from '../assets/img/spectacle-5.jpg';
import alain from '../assets/img/stage-alain-gruttadauria.jpg';
import creatif from '../assets/img/espace-activites-creatives.jpg';

const next = weekends[0];
const total = schedule.reduce((n, d) => n + d.slots.length, 0);
const finder = ages.map((a) => {
  const ds = schedule.filter((d) => a.discs.includes(d.id));
  return { ...a, names: ds.map((d) => d.name), count: ds.reduce((n, d) => n + d.slots.length, 0) };
});
---
<Base
  title="Daléas Danse"
  description="École de danse privée fondée en 1965 à Annecy. Cours de Modern’Jazz, Moderne et classe chorégraphique pour enfants, ados et adultes, stages et yoga."
>
  <h1 class="sr-only">Daléas Danse, école de danse à Annecy depuis 1965</h1>
  <HeroFloat />

  <section class="hero">
    <div class="wrap hero__row">
      <p class="lead hero__lead" data-reveal>
        École de danse privée à Annecy depuis 1965. Modern’Jazz, Moderne et classe chorégraphique, de l’éveil des tout-petits aux danseurs avancés.
      </p>
      <div class="hero__ctas" data-reveal style="--d:.08s">
        <a href="/horaires/" class="btn">Voir les horaires</a>
        <a href="/ecole/" class="tlink">Découvrir l’école</a>
      </div>
    </div>
  </section>

  <div class="marq" aria-hidden="true">
    <div class="marq__track" data-marq>
      {[0, 1].map(() => (
        <span class="marq__set">
          {['Modern’Jazz', 'Moderne', 'Classe chorégraphique', 'Éveil rythmique', 'Stages', 'Yoga', 'Depuis 1965'].map((w) => <><span class="marq__w">{w}</span><i class="marq__dot"></i></>)}
        </span>
      ))}
    </div>
  </div>

  <section class="expand" data-progress aria-label="Le spectacle de l’école">
    <div class="expand__sticky">
      <p class="expand__w expand__w--l" aria-hidden="true">Spec</p>
      <p class="expand__w expand__w--r" aria-hidden="true">tacle</p>
      <div class="expand__frame">
        <Image src={gala} alt="Les élèves de l’école réunis sur scène pour le spectacle de fin d’année" widths={[960, 1280]} sizes="100vw" />
      </div>
      {announcement.show && (
        <div class="expand__caption">
          <a href="/contact-tel/" class="chip">{announcement.eyebrow} — {announcement.title}</a>
        </div>
      )}
    </div>
  </section>

  <section class="hub-intro">
    <div class="wrap">
      <p class="kicker">Bienvenue</p>
      <p class="manif" data-words>
        {'Depuis 1965, l’école Daléas fait danser Annecy. Maryse a ouvert la voie, Diane et Delphine la prolongent : la technique, le rythme, la scène'.split(' ').map((w) => <><span class="w">{w}</span>{' '}</>)}
        <em>{'— et avant tout le plaisir de bouger.'.split(' ').map((w) => <><span class="w">{w}</span>{' '}</>)}</em>
      </p>
    </div>
  </section>

  <section class="finder sec">
    <div class="wrap">
      <div class="finder__head">
        <p class="label muted">Trouver son cours</p>
        <p class="label muted">Pour qui ?</p>
      </div>
      <ul class="finder__list">
        {finder.map((a, i) => (
          <li data-reveal style={`--d:${i * 0.06}s`}>
            <a href={`/horaires/?age=${a.id}`} class="finder__a">
              <span class="label muted">{a.label}</span>
              <span class="finder__t">{a.short}</span>
              <span class="finder__d">{a.names.join(' · ')}</span>
              <span class="finder__go">{a.count} cours par semaine</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sommaire sec">
    <div class="wrap">
      <div class="sommaire__head">
        <p class="label muted">Sommaire</p>
        <p class="label muted">Daléas Danse — Annecy</p>
      </div>
      <IndexList
        items={[
          { label: 'L’école', meta: 'Depuis 1965', href: '/ecole/', img: eveil, pos: '45% 40%' },
          { label: 'Horaires', meta: `${total} cours par semaine`, href: '/horaires/', img: studioClass, pos: '75% 50%' },
          { label: 'Tarifs', meta: `Dès ${singleClass} € le cours`, href: '/daleas-danse-annecy-tarifs/', img: sp2 },
          { label: 'Stages', meta: next ? `Prochain : ${next.date}` : 'Chorégraphes invités', href: '/stages/', img: alain, pos: '50% 30%' },
          { label: 'Yoga', meta: 'Viniyoga avec Maryse', href: '/yoga-annecy/', img: yoga },
          { label: 'Location', meta: 'Trois studios', href: '/espace-daleas-location-de-salles-annecy/', img: creatif },
          { label: 'Galerie', meta: 'La sphère en 3D', href: '/galerie/', img: sp5 },
          { label: 'Contact', meta: 'Diane & Delphine', href: '/contact-tel/', img: team, pos: '40% 45%' },
        ]}
      />
    </div>
  </section>
</Base>

<script>
  const track = document.querySelector<HTMLElement>('[data-marq]');
  if (track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let x = 0, dir = -1, boost = 0, lastY = scrollY, w = 0, on = true;
    const size = () => { w = (track.firstElementChild as HTMLElement).offsetWidth; };
    size();
    addEventListener('resize', size);
    new IntersectionObserver(([e]) => { on = e.isIntersecting; }).observe(track);
    const tick = () => {
      const dy = scrollY - lastY;
      lastY = scrollY;
      if (dy) dir = dy > 0 ? -1 : 1;
      boost += (Math.min(40, Math.abs(dy)) - boost) * 0.1;
      if (on && w) {
        x += dir * (0.6 + boost * 0.5);
        if (x <= -w) x += w;
        if (x > 0) x -= w;
        track.style.transform = `translate3d(${x.toFixed(2)}px, 0, 0) skewX(${(-dir * boost * 0.25).toFixed(2)}deg)`;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .hero { padding: clamp(1.5rem, 4vh, 2.5rem) 0 clamp(3rem, 8vh, 5rem); }
  .hero__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
  }
  .hero__lead { max-width: 38rem; }
  .hero__ctas { display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }

  .marq { overflow: hidden; padding: clamp(1rem, 3vw, 2rem) 0 clamp(2.5rem, 6vw, 4.5rem); }
  .marq__track { display: flex; width: max-content; will-change: transform; }
  .marq__set { display: flex; align-items: center; flex-shrink: 0; }
  .marq__w { font-size: clamp(2.6rem, 7vw, 7rem); font-weight: 200; line-height: 1; letter-spacing: var(--tr-display); text-transform: uppercase; white-space: nowrap; padding-inline: clamp(1rem, 2.4vw, 2.2rem); }
  .marq__w:nth-child(4n + 3) { font-style: italic; font-weight: 300; }
  .marq__dot { width: clamp(10px, 1.1vw, 16px); aspect-ratio: 1; border-radius: 50%; background: var(--ink); flex-shrink: 0; }

  .expand { --p: 0; position: relative; height: 190vh; }
  .expand__sticky { position: sticky; top: 0; height: 100dvh; overflow: hidden; }
  .expand__frame {
    position: absolute;
    inset: 0;
    clip-path: inset(calc((1 - var(--p)) * 18%) calc((1 - var(--p)) * 24%) round calc((1 - var(--p)) * 10px));
    background: var(--black);
  }
  .expand__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1.2 - var(--p) * 0.2));
    will-change: transform;
  }
  .expand__w {
    position: absolute;
    top: 50%;
    z-index: 1;
    margin: 0;
    font-size: clamp(1.6rem, 7.2vw, 8rem);
    font-weight: 200;
    line-height: 1;
    letter-spacing: calc(var(--tr-display) + var(--p) * 0.35em);
    text-transform: uppercase;
    white-space: nowrap;
    font-feature-settings: 'case' 1;
    translate: 0 -50%;
    opacity: clamp(0, calc(1.15 - var(--p) * 1.3), 1);
    pointer-events: none;
  }
  .expand__w--l { right: calc(100% - (1 - var(--p)) * 24%); padding-right: clamp(0.75rem, 1.6vw, 1.75rem); }
  .expand__w--r { left: calc(100% - (1 - var(--p)) * 24%); padding-left: clamp(0.75rem, 1.6vw, 1.75rem); }
  .expand__caption { position: absolute; left: var(--side); bottom: calc(clamp(70px, 13vh, 150px) + 0.5rem); opacity: clamp(0, calc((var(--p) - 0.6) * 4), 1); }
  .expand__caption .chip { --chip-bg: var(--white); color: var(--ink); font-size: 14px; padding: 11px 16px; border-radius: 999px; }

  .hub-intro { padding: var(--section) 0; }
  .manif {
    margin-top: 1.75rem;
    max-width: 24ch;
    font-size: clamp(2rem, 4.6vw, 4.6rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: var(--tr-h2);
  }
  .manif em { font-style: italic; }
  .manif .w { opacity: 0.12; filter: blur(3px); transition: opacity 0.6s var(--ease-out), filter 0.6s var(--ease-out); }
  .manif .w.is-on { opacity: 1; filter: none; }

  .finder { padding-top: 0; }
  .finder__head { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .finder__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .finder__list li + li { border-left: 1px solid var(--line); }
  .finder__a { display: flex; flex-direction: column; gap: 0.75rem; height: 100%; padding: 1.25rem clamp(1rem, 2vw, 1.75rem) 1.5rem; transition: color 0.35s var(--ease-out), background-color 0.35s var(--ease-out); }
  .finder__list li:first-child .finder__a { padding-left: 0; }
  .finder__t { font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 200; line-height: 0.95; letter-spacing: var(--tr-h1); text-transform: uppercase; margin-top: clamp(1.5rem, 4vw, 3rem); }
  .finder__d { font-size: 14px; color: var(--fg-muted); }
  .finder__go { margin-top: auto; display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: var(--tr-caps); text-transform: uppercase; }
  .finder__go::after { content: ''; width: 7px; height: 7px; border-top: 1px solid currentColor; border-right: 1px solid currentColor; rotate: 45deg; transition: translate 0.4s var(--ease-out); }
  .finder__a:hover { color: var(--plum); }
  .finder__a:hover .finder__d { color: currentColor; }
  .finder__a:hover .finder__go::after { translate: 4px 0; }
  @media (max-width: 900px) {
    .finder__list { grid-template-columns: 1fr 1fr; }
    .finder__list li:nth-child(3) { border-left: 0; }
    .finder__list li:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .finder__list li:nth-child(3) .finder__a { padding-left: 0; }
  }
  @media (max-width: 520px) {
    .finder__list { grid-template-columns: 1fr; }
    .finder__list li + li { border-left: 0; border-top: 1px solid var(--line); }
    .finder__a { padding-left: 0; }
  }
  .sommaire__head { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }

  @media (max-width: 560px) {
    .expand { height: 160vh; }
  }
</style>
