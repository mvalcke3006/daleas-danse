---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { weekends, summerCamp, site, tel } from '../data/site';
import duo from '../assets/img/daleasdansestage-web-copyrightdaleasdanse.jpg';
import team from '../assets/img/daleasdanse-contactdianeetdelphine.jpg';
import gala from '../assets/img/daleasdanse-slide4.jpg';

const shots = [
  { img: duo, pos: '45% 30%', title: 'Stage d’été', cap: summerCamp.dates },
  { img: team, pos: '40% 50%', title: 'Modern Jazz & Moderne', cap: 'Intermédiaires, avancés, professionnels' },
  { img: gala, pos: '60% 40%', title: 'Week-ends', cap: 'Chorégraphes invités' },
];
---
<Base
  title="Stages de danse"
  description="Stages de danse à Annecy : week-ends avec des chorégraphes invités et stage d’été de 4 jours, en modern jazz, moderne et contemporain. Ouverts aux danseurs intermédiaires, avancés et professionnels."
>
  <PageHero kicker="Association Danse Découverte" accent="stages de danse" image={duo} pos="50% 28%">
    Stages<br /><em>chorégraphes invités</em>
    <Fragment slot="sub">Modern jazz, moderne, contemporain. Ouverts aux danseurs intermédiaires, avancés et professionnels.</Fragment>
  </PageHero>

  <section class="wrap">
    <div class="shots">
      {shots.map((s, i) => (
        <figure class="tile" data-reveal style={`--d:${i * 0.06}s`}>
          <div class="tile__img">
            {i === 0 && summerCamp.past && <span class="chip tile__tag">Édition {summerCamp.year} terminée</span>}
            <Image src={s.img} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" style={`object-position:${s.pos}`} loading="eager" />
          </div>
          <figcaption class="tile__cap label"><p>{s.title}</p><p class="muted">{s.cap}</p></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="wrap sec">
    <SectionHead n="01" label="Week-ends">Chorégraphes<br /><em>invités</em>
      <Fragment slot="aside">Chaque saison, l’école invite des danseurs et chorégraphes pour un week-end de travail intensif. D’autres invités seront annoncés au fil de l’année.</Fragment>
    </SectionHead>
    <ul class="rows we" data-reveal>
      {weekends.map((w) => (
        <li>
          <span class="label muted">{w.style}</span>
          <span class="rows__big">{w.date}</span>
          <span class="we__who"><span class="prose">{w.teacher}</span><span class="label muted">{w.note}</span></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="on-black sec stage">
    <div class="wrap">
      <SectionHead n="02" label="Été">{summerCamp.edition}
        <Fragment slot="aside">
          <p>Chaque année depuis plus de trente ans, quatre jours de danse au cœur d’Annecy. {summerCamp.dates}.</p>
          {summerCamp.past
            ? <p class="label">Les dates de la prochaine édition seront annoncées ici.</p>
            : <a href={summerCamp.registrationPdf} class="btn" target="_blank" rel="noopener">S’inscrire</a>}
        </Fragment>
      </SectionHead>
      <ul class="rows team" data-reveal>
        {summerCamp.team.map((g) => (
          <li>
            <span class="label muted">{g.style}</span>
            <span class="rows__big">{g.names.join(', ')}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap sec">
    <SectionHead n="03" label="Contact">Une question<br /><em>sur un stage ?</em></SectionHead>
    <div class="pcards cols">
      {site.teachers.map((t, i) => (
        <a href={tel(t.phone)} class="pcard" data-reveal style={`--d:${i * 0.08}s`}>
          <span class="label">{t.name}</span>
          <span class="pcard__tel xl">{t.phone}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.5vw, 20px); }
  .shots .tile__img { border-radius: 6px; }
  .we { --rc: 12rem minmax(0, 1fr) minmax(0, 0.8fr); }
  .we__who { display: grid; gap: 0.25rem; }
  .team { --rc: 12rem minmax(0, 1fr); }
  @media (max-width: 700px) { .shots { grid-template-columns: 1fr; } }
</style>
