---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Edges from '../components/Edges.astro';
import { site, schedule } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  footer?: boolean;
}
const { title, description, image = '/og.jpg', footer = true } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — École de danse à Annecy depuis 1965` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DanceSchool',
  name: 'Daléas Danse',
  url: site.url,
  logo: `${site.url}/logo.png`,
  email: site.email,
  telephone: `+33${site.teachers[0].phone.replace(/\s/g, '').slice(1)}`,
  foundingDate: '1965',
  founder: { '@type': 'Person', name: 'Maryse Daléas' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: 'FR',
  },
  sameAs: site.socials.map((s) => s.href),
  knowsAbout: schedule.map((d) => d.name),
};
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ececeb" />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Daléas Danse" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <div class="bglight" aria-hidden="true"></div>
    <a href="#contenu" class="skip btn">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    {footer && <Footer />}
    <Edges />
    <div class="lightfx" aria-hidden="true"></div>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const countUp = (el: HTMLElement) => {
        const end = Number(el.dataset.count);
        if (reduce || !Number.isFinite(end)) return;
        const from = end > 1000 ? end - 60 : 0;
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = String(Math.round(from + (end - from) * (1 - Math.pow(1 - p, 4))));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          if (el.dataset.count) countUp(el);
          io.unobserve(el);
        }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      document.querySelectorAll('[data-reveal], [data-clip], [data-count]').forEach((el) => io.observe(el));

      const progress = [...document.querySelectorAll<HTMLElement>('[data-progress]')];
      const parallax = [...document.querySelectorAll<HTMLElement>('[data-speed]')];
      const wordBlocks = [...document.querySelectorAll<HTMLElement>('[data-words]')].map((el) => ({
        el,
        words: [...el.querySelectorAll<HTMLElement>('.w')],
      }));
      let lastY = scrollY, vel = 0, lastVa = -1;
      const rootStyle = document.documentElement.style;

      const update = () => {
        const vh = innerHeight;
        progress.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.bottom < -vh || r.top > vh * 2) return;
          const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - vh)));
          el.style.setProperty('--p', p.toFixed(4));
        });
        if (!reduce) {
          parallax.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) return;
            const off = (r.top + r.height / 2 - vh / 2) * Number(el.dataset.speed);
            el.style.transform = `translate3d(0, ${off.toFixed(1)}px, 0)`;
          });
        }
        wordBlocks.forEach(({ el, words }) => {
          const r = el.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (vh * 0.6)));
          const n = Math.round(p * words.length);
          words.forEach((w, i) => w.classList.toggle('is-on', i < n));
        });
        const dy = scrollY - lastY;
        lastY = scrollY;
        vel += (dy - vel) * 0.12;
        const va = reduce ? 0 : Math.min(1, Math.abs(vel) / 45);
        if (Math.abs(va - lastVa) > 0.01 || (va === 0 && lastVa !== 0)) {
          lastVa = va;
          rootStyle.setProperty('--va', va.toFixed(3));
          rootStyle.setProperty('--vs', (Math.sign(vel) * va).toFixed(3));
        }
        requestAnimationFrame(update);
      };
      requestAnimationFrame(update);

      if (matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce) {
        const sel = '.lit, .media, .tile__img, .gal__item, .ph__img';
        let tx = innerWidth / 2, ty = innerHeight * 0.25, cx = tx, cy = ty, running = false;
        const step = () => {
          cx += (tx - cx) * 0.12;
          cy += (ty - cy) * 0.12;
          const nx = cx / innerWidth - 0.5, ny = cy / innerHeight - 0.5;
          rootStyle.setProperty('--mx', `${cx.toFixed(0)}px`);
          rootStyle.setProperty('--my', `${cy.toFixed(0)}px`);
          rootStyle.setProperty('--shx', `${(-nx * 36).toFixed(1)}px`);
          rootStyle.setProperty('--shy', `${(22 - ny * 26).toFixed(1)}px`);
          if (Math.abs(tx - cx) + Math.abs(ty - cy) > 0.5) requestAnimationFrame(step);
          else running = false;
        };
        addEventListener('pointermove', (e) => {
          tx = e.clientX; ty = e.clientY;
          if (!running) { running = true; requestAnimationFrame(step); }
          const el = (e.target as Element).closest<HTMLElement>(sel);
          if (el) {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--px', `${(((e.clientX - r.left) / r.width) * 100).toFixed(1)}%`);
            el.style.setProperty('--py', `${(((e.clientY - r.top) / r.height) * 100).toFixed(1)}%`);
          }
        }, { passive: true });
      }

      document.documentElement.classList.add('is-loaded');
      window.dispatchEvent(new Event('dd:ready'));
    </script>
    <style>
      .skip { position: fixed; top: 12px; left: 12px; z-index: 101; transform: translateY(-200%); }
      .skip:focus { transform: none; }
    </style>
  </body>
</html>
