---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Edges from '../components/Edges.astro';
import { site, schedule } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  footer?: boolean;
}
const { title, description, image = '/og.jpg', footer = true } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — École de danse à Annecy depuis 1965` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DanceSchool',
  name: 'Daléas Danse',
  url: site.url,
  logo: `${site.url}/logo.png`,
  email: site.email,
  telephone: `+33${site.teachers[0].phone.replace(/\s/g, '').slice(1)}`,
  foundingDate: '1965',
  founder: { '@type': 'Person', name: 'Maryse Daléas' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: 'FR',
  },
  sameAs: site.socials.map((s) => s.href),
  knowsAbout: schedule.map((d) => d.name),
  areaServed: 'Annecy',
  priceRange: '€€',
};

const crumbs = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: title, item: canonical },
      ],
    }
  : null;
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ececeb" />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Daléas Danse, école de danse à Annecy" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Daléas Danse" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <div class="bglight" aria-hidden="true"></div>
    <a href="#contenu" class="skip btn">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    {footer && <Footer />}
    <Edges />
    <div class="lightfx" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="cur" aria-hidden="true" data-cur><span class="cur__ring"></span><span class="cur__label" data-cur-label>Voir</span></div>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const countUp = (el: HTMLElement) => {
        const end = Number(el.dataset.count);
        if (reduce || !Number.isFinite(end)) return;
        const from = end > 1000 ? end - 60 : 0;
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = String(Math.round(from + (end - from) * (1 - Math.pow(1 - p, 4))));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          if (el.dataset.count) countUp(el);
          io.unobserve(el);
        }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      document.querySelectorAll<HTMLElement>(':is(.h1, .h2, .xl, .statement)[data-reveal]').forEach((el) => {
        if (reduce || el.querySelector('.w, [data-count]')) return;
        let n = 0;
        const walk = (node: Node) => {
          [...node.childNodes].forEach((c) => {
            if (c.nodeType === 3) {
              const frag = document.createDocumentFragment();
              (c.textContent || '').split(/(\s+)/).forEach((part) => {
                if (!part) return;
                if (/^\s+$/.test(part)) { frag.append(' '); return; }
                const o = document.createElement('span');
                o.className = 'sw';
                const i = document.createElement('span');
                i.className = 'sw__i';
                i.style.setProperty('--wi', String(n++));
                i.textContent = part;
                o.append(i);
                frag.append(o);
              });
              c.replaceWith(frag);
            } else if (c.nodeType === 1 && (c as Element).tagName !== 'BR') walk(c);
          });
        };
        walk(el);
        el.classList.add('is-split');
      });
      document.querySelectorAll('[data-reveal], [data-clip], [data-count]').forEach((el) => io.observe(el));

      const progress = [...document.querySelectorAll<HTMLElement>('[data-progress]')];
      const parallax = [...document.querySelectorAll<HTMLElement>('[data-speed]')];
      const wordBlocks = [...document.querySelectorAll<HTMLElement>('[data-words]')].map((el) => ({
        el,
        words: [...el.querySelectorAll<HTMLElement>('.w')],
      }));
      let lastY = scrollY, vel = 0, lastVa = -1;
      const rootStyle = document.documentElement.style;

      const update = () => {
        const vh = innerHeight;
        progress.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.bottom < -vh || r.top > vh * 2) return;
          const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - vh)));
          el.style.setProperty('--p', p.toFixed(4));
        });
        if (!reduce) {
          parallax.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) return;
            const off = (r.top + r.height / 2 - vh / 2) * Number(el.dataset.speed);
            el.style.transform = `translate3d(0, ${off.toFixed(1)}px, 0)`;
          });
        }
        wordBlocks.forEach(({ el, words }) => {
          const r = el.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (vh * 0.6)));
          const n = Math.round(p * words.length);
          words.forEach((w, i) => w.classList.toggle('is-on', i < n));
        });
        const dy = scrollY - lastY;
        lastY = scrollY;
        vel += (dy - vel) * 0.12;
        const va = reduce ? 0 : Math.min(1, Math.abs(vel) / 45);
        if (Math.abs(va - lastVa) > 0.01 || (va === 0 && lastVa !== 0)) {
          lastVa = va;
          rootStyle.setProperty('--va', va.toFixed(3));
          rootStyle.setProperty('--vs', (Math.sign(vel) * va).toFixed(3));
        }
        requestAnimationFrame(update);
      };
      requestAnimationFrame(update);

      if (matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce) {
        const cur = document.querySelector<HTMLElement>('[data-cur]')!;
        const curLabel = document.querySelector<HTMLElement>('[data-cur-label]')!;
        const viewSel = '.hf__p, .gal__item, .tease__media, .block__media, .full__media, .tile__img, .sph__tile, .menu__preview';
        let kx = -100, ky = -100, qx = kx, qy = ky, curOn = false;
        const curStep = () => {
          qx += (kx - qx) * 0.2;
          qy += (ky - qy) * 0.2;
          cur.style.transform = `translate3d(${qx.toFixed(1)}px, ${qy.toFixed(1)}px, 0)`;
          requestAnimationFrame(curStep);
        };
        requestAnimationFrame(curStep);
        const curState = (t: Element | null) => {
          const view = t?.closest(viewSel);
          const link = t?.closest('a, button, [role="tab"], label, select');
          cur.classList.toggle('is-view', !!view);
          cur.classList.toggle('is-link', !view && !!link);
          if (view) curLabel.textContent = view.closest('.sph__tile') ? 'Ouvrir' : 'Voir';
        };
        addEventListener('pointermove', (e) => {
          kx = e.clientX; ky = e.clientY;
          if (!curOn) { curOn = true; qx = kx; qy = ky; cur.classList.add('is-on'); }
          curState(e.target as Element);
        }, { passive: true });
        let curPending = false;
        addEventListener('scroll', () => {
          if (curPending || !curOn) return;
          curPending = true;
          requestAnimationFrame(() => { curPending = false; curState(document.elementFromPoint(kx, ky)); });
        }, { passive: true });
        document.addEventListener('pointerleave', () => cur.classList.remove('is-on'));
        document.addEventListener('pointerenter', () => cur.classList.add('is-on'));
        addEventListener('pointerdown', () => cur.classList.add('is-down'));
        addEventListener('pointerup', () => cur.classList.remove('is-down'));

        document.querySelectorAll<HTMLElement>('.btn, .nav__pill, .chip[href], .tlink').forEach((el) => {
          el.classList.add('mag');
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
            el.style.translate = `${(dx * 0.25).toFixed(1)}px ${(dy * 0.3).toFixed(1)}px`;
          });
          el.addEventListener('pointerleave', () => { el.style.translate = ''; });
        });

        const sel = '.lit, .media, .tile__img, .gal__item, .ph__img';
        let tx = innerWidth / 2, ty = innerHeight * 0.25, cx = tx, cy = ty, running = false;
        const step = () => {
          cx += (tx - cx) * 0.12;
          cy += (ty - cy) * 0.12;
          const nx = cx / innerWidth - 0.5, ny = cy / innerHeight - 0.5;
          rootStyle.setProperty('--mx', `${cx.toFixed(0)}px`);
          rootStyle.setProperty('--my', `${cy.toFixed(0)}px`);
          rootStyle.setProperty('--shx', `${(-nx * 36).toFixed(1)}px`);
          rootStyle.setProperty('--shy', `${(22 - ny * 26).toFixed(1)}px`);
          if (Math.abs(tx - cx) + Math.abs(ty - cy) > 0.5) requestAnimationFrame(step);
          else running = false;
        };
        addEventListener('pointermove', (e) => {
          tx = e.clientX; ty = e.clientY;
          if (!running) { running = true; requestAnimationFrame(step); }
          const el = (e.target as Element).closest<HTMLElement>(sel);
          if (el) {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--px', `${(((e.clientX - r.left) / r.width) * 100).toFixed(1)}%`);
            el.style.setProperty('--py', `${(((e.clientY - r.top) / r.height) * 100).toFixed(1)}%`);
          }
        }, { passive: true });
      }

      document.documentElement.classList.add('is-loaded');
      window.dispatchEvent(new Event('dd:ready'));
    </script>
    <style>
      .cur {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 120;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s var(--ease-out);
      }
      .cur.is-on { opacity: 1; }
      .cur__ring {
        position: absolute;
        left: -18px;
        top: -18px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid #fff;
        mix-blend-mode: difference;
        transition: scale 0.5s var(--ease-expo), background-color 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
      }
      .cur.is-link .cur__ring { scale: 1.7; background: #fff; }
      .cur.is-down .cur__ring { scale: 0.7; }
      .cur.is-view .cur__ring { opacity: 0; }
      .cur__label {
        position: absolute;
        left: -44px;
        top: -44px;
        width: 88px;
        height: 88px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(20, 22, 23, 0.82);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        color: #fff;
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        scale: 0.2;
        opacity: 0;
        transition: scale 0.55s var(--ease-expo), opacity 0.3s var(--ease-out);
      }
      .cur.is-view .cur__label { scale: 1; opacity: 1; }
      @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) { .cur { display: none; } }
      .skip { position: fixed; top: 12px; left: 12px; z-index: 101; transform: translateY(-200%); }
      .skip:focus { transform: none; }
    </style>
  </body>
</html>
